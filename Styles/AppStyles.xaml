<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Общие стили всех разделов. Раньше эти же стили были продублированы в
         Page.Resources каждой страницы; собраны сюда, чтобы значения дизайн-системы
         (скругления, отступы, размеры шрифта) задавались в одном месте. -->

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- Высота кнопки действия. Ресурсом, а не отступами: в «Извлечении разделов»
         кнопки стоят двумя столбцами (запуск/пауза/отмена слева, остальные действия
         справа), и строки обязаны совпасть. Столбцы независимы, поэтому равнять их
         можно только общей высотой: у левых кнопок в подписи есть значок, у правых
         нет, и по содержимому они получаются разной высоты. -->
    <sys:Double x:Key="ActionButtonMinHeight">38</sys:Double>

    <!-- Ширина колонки подписей во всех строках «подпись — поле» и в строках прогресса.
         Ресурсом, а не числом на месте: раньше в «Сборке» и в строках прогресса стояло
         190, а в остальных разделах 170, и подписи прогресс-баров не совпадали с
         подписями полей над ними на той же странице. Значение 190 — по самой длинной
         подписи («Любая часть цепочки»). -->
    <GridLength x:Key="LabelColumnWidth">190</GridLength>

    <!-- Скругление 14 у карточек и 10 у кнопок — пресет "soft" из макета. -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <!-- Цвет текста задаём явно во всех текстовых стилях. WPF-UI объявляет неявный стиль
         TextBlock пустым (<Style TargetType="{x:Type TextBlock}" />) и рассчитывает, что
         Foreground доедет по наследованию от окна. В нашем дереве (FluentWindow ->
         NavigationView -> Frame -> Page) это наследование доходит не до всех элементов:
         часть текста оставалась чёрной по умолчанию TextBlock.Foreground. На светлой теме
         чёрный совпадал с нужным цветом и баг был не виден, на тёмной — текст пропадал.
         DynamicResource, чтобы кисть менялась вместе с темой. -->
    <Style x:Key="RowLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,16,0"/>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- Название карточки со значком в цветной плитке («О программе», «Настройки»).
         Крупнее обычного заголовка карточки: рядом стоит плитка 46 точек, и подпись
         в 13 при ней читается подрисуночной. Отступ снизу не задан — он у каждой
         разметки свой: в строке с плиткой его держит сама строка. -->
    <Style x:Key="TileCardTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="RowGrid" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <!-- У CheckBox из WPF-UI Padding по умолчанию 11,5,11,6, и в шаблоне он применяется
         как Margin ко всему содержимому — то есть отодвигает вправе и сам квадратик.
         Из-за этого галочки стояли на 11px правее заголовка карточки. Убираем только
         левую часть, вертикальные отступы оставляем как в библиотеке. -->
    <Style x:Key="CardCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Padding" Value="0,5,11,6"/>
    </Style>

    <!-- У стандартного стиля кнопки WPF-UI фон при наведении/нажатии переопределяется
         на цвет темы (в светлой теме — почти белый), из-за чего белый текст этих кнопок
         становился невидимым. Свой шаблон меняет только прозрачность, а не сам цвет
         фона, — Foreground/Background остаются как заданы. -->
    <Style x:Key="SolidButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="MinHeight" Value="{StaticResource ActionButtonMinHeight}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Рамка нужна для показа фокуса с клавиатуры (см. триггер ниже),
                         поэтому здесь Grid, а не один Border: рамка рисуется поверх и
                         не меняет размер кнопки, иначе при переходе табом кнопка бы
                         дёргалась, а соседние — сдвигались. -->
                    <Grid>
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="10" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <Border x:Name="FocusRing" CornerRadius="10" BorderThickness="2" BorderBrush="White"
                                Margin="1" Visibility="Collapsed" SnapsToDevicePixels="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                        </Trigger>
                        <!-- Свой шаблон отменил стандартную рамку фокуса, и пройти по
                             вкладке табом было можно, а понять, где ты, — нет. Белая
                             рамка читается на всех трёх цветах этих кнопок (синей,
                             красной, оранжевой) в обеих темах. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PauseButtonStyle" TargetType="Button" BasedOn="{StaticResource SolidButtonStyle}">
        <Setter Property="Background" Value="#F2A93B"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                <Setter Property="Background" Value="#16A34A"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Переключатель из нескольких вариантов: общая дорожка, внутри выбранный вариант
         приподнят плашкой. Вместо ряда отдельных кнопок, у которых выбранная была
         обведена рамкой: рамка говорит «сюда можно нажать», а не «это выбрано», и по
         ряду одинаковых кнопок не читалось, что вариант тут ровно один.

         Дорожка — полупрозрачный чёрный: он темнее фона и в светлой теме, и в тёмной,
         поэтому пары значений под каждую тему не нужно. А вот плашке одного значения
         не хватило: она должна быть светлее дорожки в обеих темах, а полупрозрачный
         белый, годный для светлой, в тёмной даёт почти белый прямоугольник. Поэтому
         у неё кисть темы — ControlSolidFillColorDefault: белая в светлой, #454545
         в тёмной. -->
    <Style x:Key="SegmentedTrack" TargetType="Border">
        <Setter Property="Background" Value="#14000000"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="3"/>
    </Style>

    <!-- Один вариант в такой дорожке. Выбранное состояние задаётся снаружи: разметка
         добавляет свой DataTrigger и меняет им Background, BorderBrush и Foreground —
         шаблон берёт их привязками. Триггеры производного стиля срабатывают после
         здешних, поэтому наведение на выбранный вариант его подсветку не сбивает.

         Насыщенность у подписи одна на оба состояния, хотя на выбранной хотелось бы
         жирнее: подписи разной длины меняли бы ширину дорожки, а она стоит по правому
         краю карточки — при каждом нажатии её левый край дёргался бы на пару точек. -->
    <Style x:Key="SegmentedButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Pill" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="8" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#0F000000"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Маленькая кнопка из одного значка — сейчас это копирование хэша в окне с итогом.

         Своя раскраска, а не библиотечная, потому что палитра WPF-UI для такой кнопки
         не рассчитана: в тёмной теме фон кнопки — ControlFillColorDefault, то есть
         белый с прозрачностью 6%, а рамка — 7%. Широкой кнопке с подписью этого хватает
         (её читают по тексту), а квадрат со значком из таких величин не собирается —
         в тёмной теме он сливался с окном. В светлой теме та же кнопка получает 70%
         белого и потому видна.

         Цвета — полупрозрачный серый, один набор на обе темы: он темнее светлого фона
         и светлее тёмного, поэтому пары кистей под каждую тему не нужно (тот же приём,
         что у пунктов всплывающего меню в ShellWindow). Форму задаёт рамка: заливкой
         одинаково приподнять квадрат в обеих темах нельзя — серый в светлой теме
         темнее фона, а в тёмной светлее. -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="#26808080" BorderBrush="#59808080" BorderThickness="1"
                            CornerRadius="8" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#40808080"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#59808080"/>
                        </Trigger>
                        <!-- Свой шаблон отменяет стандартную рамку фокуса, а пройти к этой
                             кнопке табом можно — иначе было бы не видно, где ты. Синий тот же,
                             что у остальных акцентов программы. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#2F6FED"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Прогресс-бар "пилюлей": и трек, и заливка скруглены полностью, поэтому
         движущийся край всегда круглый, а не срезанный.

         Почему свой шаблон, а не Border с CornerRadius вокруг стандартного бара:
         ClipToBounds в WPF режет по прямоугольнику, а не по скруглению, — прежний
         вариант фактически не скруглял заливку вообще.

         Из макета не переносим CSS-переход width .25s ease: прогресс обновляется
         часто, и анимация заставляла бы бар постоянно догонять реальное значение. -->
    <Style x:Key="ProgressBarPill" TargetType="ProgressBar">
        <Setter Property="Height" Value="14"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"/>

                        <!-- В WPF нет внутренней тени (inset box-shadow), поэтому
                             глубину треку даёт лёгкое затемнение от верхней кромки. -->
                        <Border CornerRadius="7" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0"   Color="#1A000000"/>
                                    <GradientStop Offset="0.5" Color="#00000000"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Имена PART_Track и PART_Indicator обязательны: ширину
                             заливки WPF считает сам, по фактической ширине трека. -->
                        <Rectangle x:Name="PART_Track" Fill="Transparent"/>
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="7"
                                Background="{TemplateBinding Foreground}">
                            <Border CornerRadius="7">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0"    Color="#2EFFFFFF"/>
                                        <GradientStop Offset="0.55" Color="#00FFFFFF"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Indicator" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
