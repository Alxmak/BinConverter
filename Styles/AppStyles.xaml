<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Общие стили всех разделов. Раньше эти же стили были продублированы в
         Page.Resources каждой страницы; собраны сюда, чтобы значения дизайн-системы
         (скругления, отступы, размеры шрифта) задавались в одном месте. -->

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- Скругление 14 у карточек и 10 у кнопок — пресет "soft" из макета. -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <Style x:Key="RowLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,16,0"/>
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Opacity" Value="0.7"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="RowGrid" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <!-- У стандартного стиля кнопки WPF-UI фон при наведении/нажатии переопределяется
         на цвет темы (в светлой теме — почти белый), из-за чего белый текст этих кнопок
         становился невидимым. Свой шаблон меняет только прозрачность, а не сам цвет
         фона, — Foreground/Background остаются как заданы. -->
    <Style x:Key="SolidButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="10" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PauseButtonStyle" TargetType="Button" BasedOn="{StaticResource SolidButtonStyle}">
        <Setter Property="Background" Value="#F2A93B"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                <Setter Property="Background" Value="#16A34A"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Прогресс-бар "пилюлей": и трек, и заливка скруглены полностью, поэтому
         движущийся край всегда круглый, а не срезанный.

         Почему свой шаблон, а не Border с CornerRadius вокруг стандартного бара:
         ClipToBounds в WPF режет по прямоугольнику, а не по скруглению, — прежний
         вариант фактически не скруглял заливку вообще.

         Из макета не переносим CSS-переход width .25s ease: прогресс обновляется
         часто, и анимация заставляла бы бар постоянно догонять реальное значение. -->
    <Style x:Key="ProgressBarPill" TargetType="ProgressBar">
        <Setter Property="Height" Value="14"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"/>

                        <!-- В WPF нет внутренней тени (inset box-shadow), поэтому
                             глубину треку даёт лёгкое затемнение от верхней кромки. -->
                        <Border CornerRadius="7" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0"   Color="#1A000000"/>
                                    <GradientStop Offset="0.5" Color="#00000000"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Имена PART_Track и PART_Indicator обязательны: ширину
                             заливки WPF считает сам, по фактической ширине трека. -->
                        <Rectangle x:Name="PART_Track" Fill="Transparent"/>
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="7"
                                Background="{TemplateBinding Foreground}">
                            <Border CornerRadius="7">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0"    Color="#2EFFFFFF"/>
                                        <GradientStop Offset="0.55" Color="#00FFFFFF"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Indicator" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
