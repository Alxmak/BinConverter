<Page x:Class="BinConverter.Views.VerifyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Проверка SHA-256"
      PreviewMouseWheel="Page_PreviewMouseWheel">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.75"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="ProgressBarRounded" TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="RootScroll" Padding="24,16" VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Stretch">

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" AllowDrop="True" Drop="FileA_Drop" DragOver="Row_DragOver">
                        <TextBlock Text="Файл A" Style="{StaticResource SectionLabel}"/>
                        <TextBox Text="{Binding FileAPath}" IsReadOnly="True" Margin="0,0,0,8"/>
                        <Button Content="📁 Обзор…" Command="{Binding BrowseACommand}" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding HashAText}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Opacity="0.8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" AllowDrop="True" Drop="FileB_Drop" DragOver="Row_DragOver">
                        <TextBlock Text="Файл B" Style="{StaticResource SectionLabel}"/>
                        <TextBox Text="{Binding FileBPath}" IsReadOnly="True" Margin="0,0,0,8"/>
                        <Button Content="📁 Обзор…" Command="{Binding BrowseBCommand}" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding HashBText}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Opacity="0.8"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Padding="14" CornerRadius="8" Margin="0,0,0,14"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#1A16A34A"/>
                        <Setter Property="BorderBrush" Value="#16A34A"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMatch}" Value="False">
                                <Setter Property="Background" Value="#1AE5484D"/>
                                <Setter Property="BorderBrush" Value="#E5484D"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ResultText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>

            <!-- Прогресс (пункт 3) -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Прогресс" Style="{StaticResource CardTitle}"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Прогресс сравнения" Style="{StaticResource RowLabel}"/>
                        <Border Grid.Column="1" CornerRadius="6" ClipToBounds="True">
                            <ProgressBar Style="{StaticResource ProgressBarRounded}" Minimum="0" Maximum="100" Value="{Binding OverallProgress, Mode=OneWay}"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding CurrentFileLabel}" FontSize="10" Opacity="0.55" Margin="190,-12,0,16"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Сравнить" Command="{Binding CompareCommand}"
                                Background="#2F6FED" Foreground="White" FontWeight="SemiBold" Padding="18,9" Margin="0,0,10,0"/>
                        <Button Content="✕ Отмена" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}"
                                Background="#E5484D" Foreground="White" FontWeight="SemiBold" Padding="18,9"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.7" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Журнал (пункты 3,4,5) -->
            <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="18,16,18,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Журнал" Style="{StaticResource CardTitle}" Margin="0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Открыть" Command="{Binding OpenLogCommand}" FontSize="11" Padding="8,4" Margin="0,0,6,0"/>
                            <Button Content="Сохранить" Command="{Binding SaveLogCommand}" FontSize="11" Padding="8,4" Margin="0,0,6,0"/>
                            <Button Content="Очистить" Command="{Binding ClearLogCommand}" FontSize="11" Padding="8,4"/>
                        </StackPanel>
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding LogLines}" Height="170" BorderThickness="0"
                             FontFamily="Cascadia Code, Consolas" FontSize="11" Background="Transparent"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
