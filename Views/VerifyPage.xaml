<Page x:Class="TweakFirmware.Views.VerifyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:TweakFirmware.Services"
      xmlns:c="clr-namespace:TweakFirmware.Controls"
      Title="{loc:Loc Verify_Title}"
      ScrollViewer.CanContentScroll="False">


    <!-- Esc отменяет идущую операцию. Enter на «Начать» намеренно не назначен: на этих
         страницах есть поля ввода, и нажатие Enter при правке пути запускало бы
         многочасовую запись на диск. -->
    <Page.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Page.InputBindings>

    <ScrollViewer x:Name="RootScroll" Padding="24,16" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="960" HorizontalAlignment="Stretch">

            <!-- Пока идёт сравнение, поля ввода недоступны — см. тот же приём в Конвертировании. -->
            <Border Style="{StaticResource CardStyle}" IsEnabled="{Binding IsNotBusy}">
                <StackPanel>

                    <!-- Строк от двух до пяти, поэтому список, а не фиксированная разметка. -->
                    <ItemsControl ItemsSource="{Binding Files}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Style="{StaticResource RowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource RowLabel}"/>

                                    <!-- Цель перетаскивания — само поле; см. пояснение в Конвертировании.
                                         Строку, на которую бросили, определяет DataContext поля. -->
                                    <ui:TextBox ClearButtonEnabled="False" Grid.Column="1" Margin="0,0,8,0"
                                                Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="{loc:Loc Common_NoFileSelected}"
                                                AllowDrop="True" PreviewDragOver="FileBox_DragOver" PreviewDrop="FileBox_Drop"/>

                                    <Button Grid.Column="2" Content="{loc:Loc Common_BrowseButton}"
                                            Command="{Binding DataContext.BrowseFileCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"/>

                                    <!-- Убрать можно только лишние строки: две обязательны. -->
                                    <Button Grid.Column="3" Margin="6,0,0,0" Padding="9,6"
                                            ToolTip="{loc:Loc Verify_RemoveFileTooltip}"
                                            Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}">
                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="13"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="{loc:Loc Verify_AddFileButton}" Command="{Binding AddFileCommand}"/>
                        <TextBlock Text="{Binding MaxFilesNote}" VerticalAlignment="Center" Margin="12,0,0,0"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- «Общая информация» стоит там же, где на остальных вкладках. «Параметров»
                 в сравнении нет — ставить рядом нечего, поэтому карточка одна во всю
                 ширину: пустая половина рядом выглядела бы потерянной. -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Common_GeneralInfoTitle}" Style="{StaticResource CardTitle}"/>

                    <!-- Пока файлы не выбраны, считать нечего, и вместо строк подсказка. -->
                    <c:HintBanner Text="{loc:Loc Verify_SelectFilesHint}"
                                  Visibility="{Binding ShowInfoHint, Converter={StaticResource BoolToVis}}"/>

                    <StackPanel Visibility="{Binding HasInfo, Converter={StaticResource BoolToVis}}">
                        <!-- Тот же межстрочный интервал, что в информационных карточках
                             остальных вкладок: строки собираются кодом, и сколько их
                             будет, заранее неизвестно. -->
                        <TextBlock Text="{Binding FilesInfoText}" TextWrapping="Wrap" FontSize="13"
                                   LineHeight="24" LineStackingStrategy="BlockLineHeight"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                        <!-- Замечание о разных размерах есть не всегда, а пустой TextBlock
                             всё равно занимал бы высоту строки. -->
                        <TextBlock Text="{Binding SizeMismatchNote}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SizeMismatchNote}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Колонки те же, что на остальных вкладках. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Common_ProgressTitle}" Style="{StaticResource CardTitle}"/>

                        <c:ProgressRow Label="{loc:Loc Verify_CompareProgressLabel}"
                                       Value="{Binding OverallProgress}" Fill="#2F6FED"
                                       Caption="{Binding CurrentFileLabel}"/>
                    </StackPanel>
                </Border>

                <!-- Те же кнопки, что в Конвертировании и Сборке. PauseCommand
                     не передаём — паузы в сравнении нет, и кнопки не будет. -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <c:OperationBar StartText="{loc:Loc Verify_CompareButton}"
                                    StartCommand="{Binding StartCommand}"
                                    CancelCommand="{Binding CancelCommand}"/>
                </Border>
            </Grid>

            <!-- Результат виден всегда: до первого сравнения в баннере стоит пояснение. -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Verify_ResultTitle}" Style="{StaticResource CardTitle}"/>

                    <!-- Итог сравнения, который остаётся на экране: окно в конце закрывается,
                         а это держит результат до следующего запуска. Три состояния на двух
                         флагах: HasResult=false — нейтральное (ещё не считали или отменили),
                         дальше зелёное или красное по IsResultGood. -->
                    <Border Padding="12,10" CornerRadius="10" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasResult}" Value="True"/>
                                            <Condition Binding="{Binding IsResultGood}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="#1A16A34A"/>
                                        <Setter Property="BorderBrush" Value="#16A34A"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasResult}" Value="True"/>
                                            <Condition Binding="{Binding IsResultGood}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="#1AE5484D"/>
                                        <Setter Property="BorderBrush" Value="#E5484D"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>
                            <TextBlock Text="{Binding ResultHeadline}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasResult}" Value="True"/>
                                                    <Condition Binding="{Binding IsResultGood}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="#16A34A"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasResult}" Value="True"/>
                                                    <Condition Binding="{Binding IsResultGood}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="#E5484D"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Пока пояснения нет, второй строки не видно — пустая занимала бы высоту. -->
                            <TextBlock Text="{Binding ResultSubline}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ResultSubline}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Группы одинаковых хэшей. Одна группа — все файлы совпали;
                         больше одной — видно, сколько файлов в каждой и какие именно. -->
                    <ItemsControl ItemsSource="{Binding ResultGroups}" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Hash}" FontFamily="Cascadia Code, Consolas" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,3,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding FileNames}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <c:LogCard/>

        </StackPanel>
    </ScrollViewer>
</Page>
