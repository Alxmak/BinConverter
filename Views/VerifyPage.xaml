<Page x:Class="TweakFirmware.Views.VerifyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:TweakFirmware.Services"
      xmlns:c="clr-namespace:TweakFirmware.Controls"
      Title="{loc:Loc Verify_Title}"
      ScrollViewer.CanContentScroll="False">


    <ScrollViewer x:Name="RootScroll" Padding="24,16" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="960" HorizontalAlignment="Stretch">

            <!-- Пока идёт сравнение, поля ввода недоступны — см. тот же приём в Конвертировании. -->
            <Border Style="{StaticResource CardStyle}" IsEnabled="{Binding IsNotBusy}">
                <StackPanel>
                    <Grid Style="{StaticResource RowGrid}" AllowDrop="True" Drop="FileA_Drop" DragOver="Row_DragOver">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc Verify_FileALabel}" Style="{StaticResource RowLabel}"/>
                        <ui:TextBox ClearButtonEnabled="False" Grid.Column="1" Text="{Binding FileAPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                    PlaceholderText="{loc:Loc Common_NoFileSelected}"/>
                        <Button Grid.Column="2" Content="{loc:Loc Common_BrowseButton}" Command="{Binding BrowseACommand}"/>
                    </Grid>

                    <Grid AllowDrop="True" Drop="FileB_Drop" DragOver="Row_DragOver">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc Verify_FileBLabel}" Style="{StaticResource RowLabel}"/>
                        <ui:TextBox ClearButtonEnabled="False" Grid.Column="1" Text="{Binding FileBPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                    PlaceholderText="{loc:Loc Common_NoFileSelected}"/>
                        <Button Grid.Column="2" Content="{loc:Loc Common_BrowseButton}" Command="{Binding BrowseBCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Common_ProgressTitle}" Style="{StaticResource CardTitle}"/>

                    <c:ProgressRow Label="{loc:Loc Verify_CompareProgressLabel}"
                                   Value="{Binding OverallProgress}" Fill="#2F6FED"
                                   Caption="{Binding CurrentFileLabel}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Command="{Binding CompareCommand}" Style="{StaticResource SolidButtonStyle}"
                                Background="#2F6FED" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Play24" FontSize="14" Margin="0,0,7,0"/>
                                <TextBlock Text="{loc:Loc Verify_CompareButton}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}"
                                Style="{StaticResource SolidButtonStyle}" Background="#E5484D">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Margin="0,0,7,0"/>
                                <TextBlock Text="{loc:Loc Common_CancelButton}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Результат виден всегда: до первого сравнения показывает прочерки и
                 пояснение. Совпадение/расхождение передаётся цветом текста, а не
                 цветной заливкой карточки и не значком. -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Verify_ResultTitle}" Style="{StaticResource CardTitle}"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc Verify_HashALine}" FontFamily="Cascadia Code, Consolas"
                                   FontSize="11" Opacity="0.75" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding HashAText}" FontFamily="Cascadia Code, Consolas"
                                   FontSize="11" Opacity="0.75" TextWrapping="Wrap"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc Verify_HashBLine}" FontFamily="Cascadia Code, Consolas"
                                   FontSize="11" Opacity="0.75" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding HashBText}" FontFamily="Cascadia Code, Consolas"
                                   FontSize="11" Opacity="0.75" TextWrapping="Wrap"/>
                    </Grid>

                    <TextBlock Text="{Binding ResultText}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Opacity" Value="0.5"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasResult}" Value="True"/>
                                            <Condition Binding="{Binding IsMatch}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Foreground" Value="#16A34A"/>
                                        <Setter Property="Opacity" Value="1"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasResult}" Value="True"/>
                                            <Condition Binding="{Binding IsMatch}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Foreground" Value="#E5484D"/>
                                        <Setter Property="Opacity" Value="1"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Журнал (пункты 3,4,5) -->
            <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="18,16,18,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc Common_LogTitle}" Style="{StaticResource CardTitle}" Margin="0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{loc:Loc Common_LogOpenButton}" Command="{Binding OpenLogCommand}" FontSize="11" Padding="8,4" Margin="0,0,6,0"/>
                            <Button Content="{loc:Loc Common_LogSaveButton}" Command="{Binding SaveLogCommand}" FontSize="11" Padding="8,4" Margin="0,0,6,0"/>
                            <Button Content="{loc:Loc Common_LogClearButton}" Command="{Binding ClearLogCommand}" FontSize="11" Padding="8,4"/>
                        </StackPanel>
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding LogLines}" Height="113" BorderThickness="0"
                             FontFamily="Cascadia Code, Consolas" FontSize="11" Background="Transparent"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
