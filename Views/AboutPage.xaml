<Page x:Class="TweakFirmware.Views.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:TweakFirmware.Services"
      xmlns:c="clr-namespace:TweakFirmware.Controls"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      Title="{loc:Loc About_Title}"
      ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <!-- Ширина всех кнопок вкладки. Фиксированная по двум причинам: они стоят
             в правой колонке карточек друг под другом и обязаны выстроиться в один
             столбец, а у «Скопировать адрес» подпись на пару секунд меняется на
             «Адрес скопирован» — без общей ширины колонка дёргалась бы на каждое
             нажатие. Значение — по самой длинной подписи с запасом на английский. -->
        <sys:Double x:Key="AboutButtonWidth">190</sys:Double>
    </Page.Resources>


    <ScrollViewer x:Name="RootScroll" Padding="24,16" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="960" HorizontalAlignment="Stretch">

            <!-- Шапка тоже карточка: раньше она висела «в воздухе» над остальными
                 и выбивалась из ряда. Значок и отступы — как у плитки в IconCard,
                 чтобы заголовок программы стоял на одной вертикали с заголовками
                 карточек под ним. -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/AppIcon-256.png" Width="46" Height="46" Margin="0,0,16,0"
                           Stretch="Uniform" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc Common_AppName}" FontSize="20" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <!-- Номер версии плашкой рядом с названием, а не строкой под ним:
                                 строка читалась как часть описания, хотя описанию там и место.

                                 Отступ сверху — поправка на то, как устроена строка текста,
                                 а не подгонка на глаз. Выравнивание по центру считает высоту
                                 всей строки, включая место под хвосты букв (у «g», «p»),
                                 а в «Tweak Firmware» таких букв нет: видимые буквы стоят
                                 в верхней части строки, и плашка ровно по центру строки
                                 читается задранной.

                                 Числа тут вдвое больше, чем сдвиг: при VerticalAlignment="Center"
                                 односторонний отступ съедается центрированием пополам —
                                 элемент центруется в том, что осталось от высоты после
                                 вычета отступов. Шесть сверху дают три пикселя вниз;
                                 первая попытка с двумя дала один и была почти незаметна. -->
                            <c:Badge Text="{Binding VersionText}" ToolTip="{Binding VersionTooltip}"
                                     Margin="10,6,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{loc:Loc About_TaglineText}" TextWrapping="Wrap" FontSize="13" Margin="0,6,0,0"
                                   LineHeight="19" LineStackingStrategy="BlockLineHeight"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <c:IconCard Symbol="CloudArrowDown24" Accent="#2F6FED"
                        Title="{loc:Loc About_UpdatesTitle}"
                        Description="{loc:Loc About_UpdatesDescription}">
                <c:IconCard.Action>
                    <Button Content="{loc:Loc About_CheckUpdatesButton}"
                            Command="{Binding CheckForUpdatesCommand}"
                            MinWidth="{StaticResource AboutButtonWidth}"
                            MinHeight="{StaticResource ActionButtonMinHeight}"
                            HorizontalContentAlignment="Center"/>
                </c:IconCard.Action>
                <c:IconCard.Extra>
                    <!-- Итог последней проверки. Пока не нажимали — строки нет,
                         иначе она занимала бы высоту пустым местом. -->
                    <TextBlock Text="{Binding UpdateStatusText}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdateStatusText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </c:IconCard.Extra>
            </c:IconCard>

            <c:IconCard Symbol="Code24" Accent="#16A34A"
                        Title="{loc:Loc About_DevelopmentTitle}"
                        Description="{loc:Loc About_DevelopmentText}">
                <c:IconCard.Action>
                    <!-- Адрес в кнопку не вписан: его отдаёт ViewModel оттуда же, откуда
                         проверка обновлений берёт репозиторий. -->
                    <Button Content="{loc:Loc About_GitHubButton}"
                            Command="{Binding OpenGitHubCommand}"
                            ToolTip="{Binding RepositoryUrl}"
                            MinWidth="{StaticResource AboutButtonWidth}"
                            MinHeight="{StaticResource ActionButtonMinHeight}"
                            HorizontalContentAlignment="Center"/>
                </c:IconCard.Action>
                <c:IconCard.Extra>
                    <TextBlock Text="{loc:Loc About_PersonalUseText}" TextWrapping="Wrap" FontSize="13" Margin="0,4,0,0"
                               LineHeight="19" LineStackingStrategy="BlockLineHeight"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </c:IconCard.Extra>
            </c:IconCard>

            <!-- Обратная связь: письмо открывает почтовый клиент пользователя, своего
                 сервера у программы нет. Раньше здесь стояла форма из трёх полей —
                 имя, обратный адрес и сообщение, — то есть почтовый клиент внутри
                 почтового клиента: набранное всё равно уезжало в письмо, которое
                 человек дописывал и отправлял уже у себя. Осталось то, ради чего
                 форма и была: открыть письмо и получить адрес. Самого адреса на
                 виду нет — он зашит в обе кнопки, и строкой в карточке только
                 занимал место. -->
            <c:IconCard Symbol="Chat24" Accent="#6366F1"
                        Title="{loc:Loc Feedback_Title}"
                        Description="{loc:Loc Feedback_Intro}">
                <c:IconCard.Action>
                    <!-- Друг под другом и той же ширины, что кнопка «Проверить
                         обновления»: три кнопки вкладки стоят одним столбцом
                         по правому краю карточек. -->
                    <StackPanel>
                        <Button Content="{loc:Loc Feedback_WriteButton}"
                                Command="{Binding WriteFeedbackCommand}" Margin="0,0,0,8"
                                MinWidth="{StaticResource AboutButtonWidth}"
                                MinHeight="{StaticResource ActionButtonMinHeight}"
                                HorizontalContentAlignment="Center"/>
                        <Button Command="{Binding CopyEmailCommand}"
                                MinWidth="{StaticResource AboutButtonWidth}"
                                MinHeight="{StaticResource ActionButtonMinHeight}"
                                HorizontalContentAlignment="Center">
                            <!-- Об удачном копировании говорит сама кнопка, а не строка
                                 под карточкой: подпись на пару секунд меняется
                                 и возвращается обратно (см. CopyEmail). -->
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{loc:Loc Feedback_CopyAddressButton}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AddressCopied}" Value="True">
                                                <Setter Property="Text" Value="{loc:Loc Feedback_AddressCopiedButton}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </c:IconCard.Action>
                <c:IconCard.Extra>
                    <!-- Единственное, о чём кнопкой не скажешь: буфер обмена занят
                         другим приложением. Об удачном нажатии карточка молчит —
                         почтовый клиент открывается сам и виден без подписи. -->
                    <TextBlock Text="{Binding FeedbackStatusText}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FeedbackStatusText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </c:IconCard.Extra>
            </c:IconCard>

            <c:IconCard Symbol="Globe24" Accent="#0D9488"
                        Title="{loc:Loc About_SourcesTitle}"
                        Description="{loc:Loc About_SourcesDescription}">
                <!-- Ссылки кнопками, а не строками: в остальных карточках вкладки
                     действие — это кнопка справа, и список ссылок под пояснением
                     выбивался из общего столбца единственный.

                     Адрес каждой кнопки лежит в CommandParameter, а подсказка привязана
                     к нему же: сам адрес теперь не на виду, и куда ведёт кнопка, должно
                     быть видно до нажатия. Второй раз тот же адрес в разметке не пишем —
                     иначе подпись и ссылка однажды разойдутся. -->
                <c:IconCard.Action>
                    <StackPanel>
                        <Button Content="{loc:Loc About_SourceRemontAud}"
                                Command="{Binding OpenLinkCommand}" CommandParameter="https://remont-aud.net"
                                ToolTip="{Binding CommandParameter, RelativeSource={RelativeSource Self}}"
                                MinWidth="{StaticResource AboutButtonWidth}"
                                MinHeight="{StaticResource ActionButtonMinHeight}"
                                HorizontalContentAlignment="Center" Margin="0,0,0,8"/>
                        <Button Content="{loc:Loc About_SourceMslWorks}"
                                Command="{Binding OpenLinkCommand}" CommandParameter="https://mslw.com"
                                ToolTip="{Binding CommandParameter, RelativeSource={RelativeSource Self}}"
                                MinWidth="{StaticResource AboutButtonWidth}"
                                MinHeight="{StaticResource ActionButtonMinHeight}"
                                HorizontalContentAlignment="Center" Margin="0,0,0,8"/>
                        <Button Content="{loc:Loc About_SourceTeleservis}"
                                Command="{Binding OpenLinkCommand}" CommandParameter="https://teleservis.net"
                                ToolTip="{Binding CommandParameter, RelativeSource={RelativeSource Self}}"
                                MinWidth="{StaticResource AboutButtonWidth}"
                                MinHeight="{StaticResource ActionButtonMinHeight}"
                                HorizontalContentAlignment="Center" Margin="0,0,0,8"/>
                        <!-- Именно http: по https сайт не отвечает (проверено запросом),
                             и кнопка с https молча вела бы в никуда. -->
                        <Button Content="{loc:Loc About_SourceMuuh}"
                                Command="{Binding OpenLinkCommand}" CommandParameter="http://muuh.ru"
                                ToolTip="{Binding CommandParameter, RelativeSource={RelativeSource Self}}"
                                MinWidth="{StaticResource AboutButtonWidth}"
                                MinHeight="{StaticResource ActionButtonMinHeight}"
                                HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </c:IconCard.Action>
            </c:IconCard>

        </StackPanel>
    </ScrollViewer>
</Page>
