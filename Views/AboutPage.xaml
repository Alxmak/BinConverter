<Page x:Class="TweakFirmware.Views.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:TweakFirmware.Services"
      xmlns:c="clr-namespace:TweakFirmware.Controls"
      Title="{loc:Loc About_Title}"
      ScrollViewer.CanContentScroll="False">


    <ScrollViewer x:Name="RootScroll" Padding="24,16" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="960" HorizontalAlignment="Stretch">

            <!-- Шапка тоже карточка: раньше она висела «в воздухе» над остальными
                 и выбивалась из ряда. Значок и отступы — как у плитки в AboutCard,
                 чтобы заголовок программы стоял на одной вертикали с заголовками
                 карточек под ним. -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/AppIcon-256.png" Width="46" Height="46" Margin="0,0,16,0" Stretch="Uniform"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Tweak Firmware" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{Binding VersionText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <c:AboutCard Symbol="CloudArrowDown24" Accent="#2F6FED"
                         Title="{loc:Loc About_UpdatesTitle}"
                         Description="{loc:Loc About_UpdatesDescription}">
                <c:AboutCard.Action>
                    <Button Command="{Binding CheckForUpdatesCommand}" MinHeight="{StaticResource ActionButtonMinHeight}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc About_CheckUpdatesButton}" VerticalAlignment="Center"/>
                            <!-- Уголок как у пунктов, ведущих дальше: нажатие уходит
                                 наружу, к списку релизов, а не меняет что-то на месте. -->
                            <ui:SymbolIcon Symbol="ChevronRight24" FontSize="12" Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Button>
                </c:AboutCard.Action>
                <c:AboutCard.Extra>
                    <!-- Итог последней проверки. Пока не нажимали — строки нет,
                         иначе она занимала бы высоту пустым местом. -->
                    <TextBlock Text="{Binding UpdateStatusText}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdateStatusText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </c:AboutCard.Extra>
            </c:AboutCard>

            <c:AboutCard Symbol="Code24" Accent="#16A34A"
                         Title="{loc:Loc About_DevelopmentTitle}"
                         Description="{loc:Loc About_DevelopmentText}">
                <c:AboutCard.Extra>
                    <TextBlock Text="{loc:Loc About_PersonalUseText}" TextWrapping="Wrap" FontSize="13" Margin="0,4,0,0"
                               LineHeight="19" LineStackingStrategy="BlockLineHeight"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </c:AboutCard.Extra>
            </c:AboutCard>

            <!-- Обратная связь: письмо открывает почтовый клиент пользователя, своего
                 сервера у программы нет. Раньше здесь стояла форма из трёх полей —
                 имя, обратный адрес и сообщение, — то есть почтовый клиент внутри
                 почтового клиента: набранное всё равно уезжало в письмо, которое
                 человек дописывал и отправлял уже у себя. Осталось то, ради чего
                 форма и была: открыть письмо и узнать адрес. -->
            <c:AboutCard Symbol="Chat24" Accent="#6366F1"
                         Title="{loc:Loc Feedback_Title}"
                         Description="{loc:Loc Feedback_Intro}">
                <c:AboutCard.Extra>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Command="{Binding WriteFeedbackCommand}" Margin="0,0,8,0"
                                    MinHeight="{StaticResource ActionButtonMinHeight}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Mail24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc Feedback_WriteButton}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CopyEmailCommand}" MinHeight="{StaticResource ActionButtonMinHeight}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Copy24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc Feedback_CopyAddressButton}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Адрес виден и кликабелен: почтовый клиент есть не у всех,
                             и переписать адрес глазами должно быть можно. -->
                        <TextBlock FontSize="12" Margin="0,10,0,0" FontFamily="Cascadia Code, Consolas">
                            <Hyperlink NavigateUri="{Binding ContactMailtoUri}" RequestNavigate="Hyperlink_RequestNavigate">
                                <TextBlock Text="{Binding ContactEmail}"/>
                            </Hyperlink>
                        </TextBlock>

                        <TextBlock Text="{Binding FeedbackStatusText}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FeedbackStatusText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </c:AboutCard.Extra>
            </c:AboutCard>

            <c:AboutCard Symbol="Globe24" Accent="#0D9488"
                         Title="{loc:Loc About_SourcesTitle}"
                         Description="{loc:Loc About_SourcesDescription}">
                <c:AboutCard.Extra>
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock FontSize="13" Margin="0,0,0,6">
                            <Hyperlink NavigateUri="https://remont-aud.net" RequestNavigate="Hyperlink_RequestNavigate">https://remont-aud.net</Hyperlink>
                        </TextBlock>
                        <TextBlock FontSize="13" Margin="0,0,0,6">
                            <Hyperlink NavigateUri="https://mslw.com/bb/index.php" RequestNavigate="Hyperlink_RequestNavigate">https://mslw.com/bb/index.php</Hyperlink>
                        </TextBlock>
                        <TextBlock FontSize="13">
                            <Hyperlink NavigateUri="https://teleservis.net" RequestNavigate="Hyperlink_RequestNavigate">https://teleservis.net</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </c:AboutCard.Extra>
            </c:AboutCard>

        </StackPanel>
    </ScrollViewer>
</Page>
