<Page x:Class="TweakFirmware.Views.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:TweakFirmware.Services"
      Title="{loc:Loc About_Title}"
      ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="RootScroll" Padding="24,20" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Border Width="44" Height="44" CornerRadius="10" Margin="0,0,14,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2F6FED" Offset="0"/>
                            <GradientStop Color="#5B93FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="T" Foreground="White" FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Tweak Firmware" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding VersionText}" FontSize="12" Opacity="0.6"/>
                </StackPanel>
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc About_UpdatesTitle}" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="{loc:Loc About_CheckUpdatesButton}" Command="{Binding CheckForUpdatesCommand}"/>
                    </Grid>
                    <TextBlock Text="{Binding UpdateStatusText}" Opacity="0.7" FontSize="12"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc About_DevelopmentTitle}" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="{loc:Loc About_DevelopmentText}" TextWrapping="Wrap" FontSize="13" LineHeight="20"/>
                    <TextBlock Text="{loc:Loc About_PersonalUseText}" TextWrapping="Wrap" FontSize="13" Margin="0,10,0,0" Opacity="0.85"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{loc:Loc About_SourcesTitle}" Style="{StaticResource CardTitle}"/>
                    <TextBlock FontSize="13" Margin="0,0,0,6">
                        <Hyperlink NavigateUri="https://remont-aud.net" RequestNavigate="Hyperlink_RequestNavigate">https://remont-aud.net</Hyperlink>
                    </TextBlock>
                    <TextBlock FontSize="13" Margin="0,0,0,6">
                        <Hyperlink NavigateUri="https://mslw.com/bb/index.php" RequestNavigate="Hyperlink_RequestNavigate">https://mslw.com/bb/index.php</Hyperlink>
                    </TextBlock>
                    <TextBlock FontSize="13">
                        <Hyperlink NavigateUri="https://teleservis.net" RequestNavigate="Hyperlink_RequestNavigate">https://teleservis.net</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
