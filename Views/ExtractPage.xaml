<Page x:Class="TweakFirmware.Views.ExtractPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:TweakFirmware.Services"
      xmlns:c="clr-namespace:TweakFirmware.Controls"
      xmlns:vm="clr-namespace:TweakFirmware.ViewModels"
      Title="{loc:Loc Extract_Title}"
      ScrollViewer.CanContentScroll="False">

    <!-- Esc отменяет идущую операцию. Enter на запуске намеренно не назначен: на этих
         страницах есть поля ввода, и нажатие Enter при правке пути запускало бы
         долгое чтение диска. Как на остальных трёх вкладках. -->
    <Page.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Page.InputBindings>

    <ScrollViewer x:Name="RootScroll" Padding="24,16" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="960" HorizontalAlignment="Stretch">

            <!-- Пока идёт разбор или извлечение, поля недоступны: менять дамп или папку
                 на ходу нельзя — параметры разойдутся с запущенной работой. IsEnabled
                 наследуется вглубь, поэтому достаточно поставить его на карточку. -->
            <Border Style="{StaticResource CardStyle}" IsEnabled="{Binding IsNotBusy}">
                <StackPanel>

                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc Common_SourceFileLabel}" Style="{StaticResource RowLabel}"/>
                        <!-- Перетаскивание принимает само поле, а не строка целиком —
                             см. подробное пояснение в «Конвертировании». -->
                        <ui:TextBox ClearButtonEnabled="False" Grid.Column="1" Margin="0,0,8,0"
                                    Style="{StaticResource PathBox}"
                                    Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{loc:Loc Common_NoFileSelected}"
                                    AllowDrop="True" PreviewDragOver="SourceBox_DragOver" PreviewDrop="SourceBox_Drop"/>
                        <Button Grid.Column="2" Content="{loc:Loc Common_BrowseButton}" Command="{Binding BrowseSourceCommand}"/>
                    </Grid>

                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc Common_DestinationFolderLabel}" Style="{StaticResource RowLabel}"/>
                        <!-- Своя подсказка, а не общая «Папка не выбрана»: здесь пустое поле
                             значит «рядом с дампом», а не «не задано». -->
                        <ui:TextBox ClearButtonEnabled="False" Grid.Column="1" Margin="0,0,8,0"
                                    Style="{StaticResource PathBox}"
                                    Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{loc:Loc Extract_OutputPlaceholder}"
                                    AllowDrop="True" PreviewDragOver="OutputBox_DragOver" PreviewDrop="OutputBox_Drop"/>
                        <Button Grid.Column="2" Content="{loc:Loc Common_BrowseButton}" Command="{Binding BrowseOutputCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Общая информация и Параметры — рядом, как в «Конвертировании»: страница
                 не растёт вниз и её меньше приходится листать. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Common_GeneralInfoTitle}" Style="{StaticResource CardTitle}"/>

                        <!-- До разбора итог ничего не сообщает о дампе, поэтому на его месте
                             подсказка — та же, что в остальных разделах. -->
                        <c:HintBanner Text="{loc:Loc Common_SelectFileHint}"
                                      Visibility="{Binding ShowInfoHint, Converter={StaticResource BoolToVis}}"/>

                        <!-- Тот же межстрочный интервал, что в информационных карточках
                             остальных вкладок: содержимое собирается кодом, и число строк
                             заранее неизвестно. -->
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="13"
                                   LineHeight="24" LineStackingStrategy="BlockLineHeight"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Visibility="{Binding HasInfo, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" IsEnabled="{Binding IsNotBusy}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Common_ParametersTitle}" Style="{StaticResource CardTitle}"/>
                        <!-- Второй проход дольше первого: он читает дамп целиком, а не по
                             нескольким адресам. Поэтому спрашиваем галочкой заранее,
                             а не диалогом посреди работы. -->
                        <CheckBox Style="{StaticResource CardCheckBox}"
                                  Content="{loc:Loc Extract_SearchFileSystemsCheckbox}"
                                  IsChecked="{Binding SearchFileSystems}" Margin="0,0,0,10"/>

                        <!-- Оба параметра относятся к «Извлечь отмеченные»: только она
                             пишет столько, что место стоит считать заранее, и оставляет
                             после себя папку. -->
                        <CheckBox Style="{StaticResource CardCheckBox}"
                                  Content="{loc:Loc Common_CheckDiskSpaceCheckbox}"
                                  IsChecked="{Binding CheckDiskSpace}" Margin="0,0,0,10"/>
                        <CheckBox Style="{StaticResource CardCheckBox}"
                                  Content="{loc:Loc Common_OpenFolderCheckbox}"
                                  IsChecked="{Binding OpenFolderAfter}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Те же две колонки, что у «Общей информации» и «Параметров» выше.
                 Все кнопки вкладки собраны в правой карточке одним столбцом: в
                 половине ширины страницы прежние ряды («Извлечь» — «Сохранить .udev»
                 — «Разделить NAND») не помещаются, а StackPanel не переносит их
                 на вторую строку, а обрезает. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Common_ProgressTitle}" Style="{StaticResource CardTitle}"/>

                        <!-- Полоса та же, что на остальных вкладках. Название текущего этапа
                             идёт подписью под ней — у ProgressRow для этого есть Caption. -->
                        <c:ProgressRow Label="{loc:Loc Extract_AnalysisProgressLabel}"
                                       Value="{Binding Progress}" Fill="#2F6FED"
                                       Caption="{Binding StageLabel}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <!-- Кнопки идут двумя столбцами, строка в строку: слева запуск, пауза
                         и отмена, справа — остальные действия вкладки. Раньше правые стояли
                         под левыми, и карточка вытягивалась вниз вдвое.

                         Строки совпадают за счёт общей минимальной высоты
                         (ActionButtonMinHeight): столбцы независимы, а по содержимому
                         кнопки разной высоты — у левых в подписи есть значок, у правых нет. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Главное действие вкладки, пауза и отмена — общими кнопками.
                             Пауза приходит от ViewModel и сама гаснет на разборе: он её
                             не поддерживает. -->
                        <c:OperationBar Grid.Column="0"
                                        StartText="{loc:Loc Extract_StartButton}"
                                        StartCommand="{Binding AnalyseCommand}"
                                        PauseCommand="{Binding TogglePauseCommand}"
                                        CancelCommand="{Binding CancelCommand}"/>

                        <!-- Остальные действия. Скрывать их не нужно: доступность решает
                             CanExecute самих команд, как и везде в программе. «Разделить»
                             просит дамп NAND, а не результат разбора, поэтому кнопка не
                             спрятана за таблицей.

                             Отступы между кнопками те же 8, что и в OperationBar, иначе
                             столбцы разъедутся уже на второй строке. Padding уменьшен:
                             «Разделить на main и spare» — самая длинная подпись в программе,
                             и в половину карточки она помещается только так. -->
                        <StackPanel Grid.Column="2">
                            <Button Content="{loc:Loc Extract_ExtractButton}" Command="{Binding ExtractCommand}"
                                    MinHeight="{StaticResource ActionButtonMinHeight}" Padding="10,6" Margin="0,0,0,8"/>
                            <Button Content="{loc:Loc Extract_SaveUdevButton}" Command="{Binding SaveUdevCommand}"
                                    MinHeight="{StaticResource ActionButtonMinHeight}" Padding="10,6" Margin="0,0,0,8"/>
                            <Button Content="{loc:Loc Extract_SplitNandButton}" Command="{Binding SplitNandCommand}"
                                    MinHeight="{StaticResource ActionButtonMinHeight}" Padding="10,6"/>

                            <!-- Появляется только у прошивок Philips: только для них в дампе
                                 есть модель, версия и серийный номер, из которых собирается
                                 имя. Предлагаемое имя идёт под кнопкой, а не рядом: в узком
                                 столбце оно длиннее оставшегося места и с переносом
                                 читается целиком. -->
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding CanRename, Converter={StaticResource BoolToVis}}">
                                <Button Content="{loc:Loc Extract_RenameButton}" Command="{Binding RenameDumpCommand}"
                                        MinHeight="{StaticResource ActionButtonMinHeight}" Padding="10,6"/>
                                <TextBlock Text="{Binding SuggestedFileName}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Таблица разделов появляется только после успешного разбора. -->
            <Border Style="{StaticResource CardStyle}"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Extract_PartitionsTitle}" Style="{StaticResource CardTitle}"/>

                    <!-- Для дампа eMMC переключатель бессмыслен: координаты совпадают.
                         Кнопок «Отметить все» и «Снять отметки» здесь больше нет — их
                         заменяет общая галочка в шапке таблицы. -->
                    <CheckBox Content="{loc:Loc Extract_ShowPhysicalCheckbox}"
                              IsChecked="{Binding ShowPhysicalAddresses}"
                              Margin="0,0,0,8"
                              Visibility="{Binding IsNandDump, Converter={StaticResource BoolToVis}}"/>

                    <!-- Таблица только для чтения: править в ней нечего, а отметки
                         разделов стоят на своём CheckBox в шаблоне колонки и правку
                         ячейки не задействуют — см. пояснение у самой колонки. -->
                    <DataGrid x:Name="PartitionsGrid" ItemsSource="{Binding Partitions}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              MaxHeight="420" SelectionMode="Single"
                              PreviewMouseLeftButtonDown="Partitions_PreviewMouseLeftButtonDown"
                              MouseRightButtonUp="Partitions_MouseRightButtonUp"
                              CanUserReorderColumns="False" CanUserResizeColumns="False"
                              Background="Transparent" BorderThickness="0"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}">

                        <!-- Свой шаблон строки. Шаблон WPF-UI держит слева отдельную
                             колонку под полоску выделения шириной 3px, и появлялась она
                             только у выделенной строки. Отсюда всё сразу: строка съезжала
                             вправо, у неё не хватало этих 3px под колонки (ширины-то
                             общие на всю таблицу), и внизу вылезала горизонтальная полоса
                             прокрутки ради трёх пикселей. Здесь полоски нет вовсе,
                             а выделение — та же подложка, что и при наведении.

                             Шаблон свой, а не подправленный библиотечный: дотянуться
                             до полоски снаружи нельзя, её Visibility выставляет триггер
                             внутри шаблона. Заголовок строки и панель подробностей
                             не нужны — заголовки строк скрыты, подробностей нет.
                             Горизонтальные линии от шаблона не зависят: их рисует
                             сама ячейка (DataGridCell.OnRender). -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridRow">
                                            <Border x:Name="RowBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    SnapsToDevicePixels="True">
                                                <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background"
                                                            Value="{DynamicResource ListViewItemBackgroundPointerOver}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background"
                                                            Value="{DynamicResource ListViewItemBackgroundPointerOver}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.RowStyle>

                        <!-- Отступ слева убран и у ячеек, и у шапки: в стилях WPF-UI это
                             6px у ячейки и 8px у заголовка, из-за чего вся таблица стояла
                             правее заголовка карточки. Расстояние между колонками держится
                             теперь правым отступом, а левый край первой колонки совпадает
                             с «Найденными разделами».

                             BasedOn обязателен (стиль без него вытесняет Template и контрол
                             перестаёт рисоваться), а базовые стили здесь именованные:
                             неявных для DataGridCell и DataGridColumnHeader в библиотеке
                             нет, их раздаёт сам стиль DataGrid через CellStyle
                             и ColumnHeaderStyle. Имена ключей — деталь WPF-UI: если
                             в новой версии их переименуют, окно упадёт при открытии
                             вкладки, а не при сборке. -->
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DefaultDataGridCellStyle}">
                                <Setter Property="Padding" Value="0,0,12,0"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}">
                                <Setter Property="Padding" Value="0,4,12,4"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <!-- Колонка отметок собрана шаблоном, а не DataGridCheckBoxColumn.
                                 У той галочка в обычной ячейке нарисована стилем, который
                                 намеренно ставит ей IsHitTestVisible="False" и Focusable="False"
                                 («вне правки состояние менять нельзя» — так и записано в WPF).
                                 Щелчок до галочки не доходит: он достаётся ячейке, та выделяет
                                 строку и переводит себя в правку, подставляя вместо картинки
                                 настоящую галочку, — и только второй щелчок её переключает.
                                 Отсюда и брались два клика на одну отметку.

                                 Тот же стиль был виден и глазами: он создаётся без BasedOn,
                                 поэтому вытеснял стиль WPF-UI целиком, и в таблице стояли
                                 обычные системные галочки с чёрной птичкой — не такие, как
                                 везде в программе. Обычный CheckBox в шаблоне и щелчок
                                 принимает сам, с первого раза, и внешний вид берёт общий:
                                 неявный стиль библиотеки лежит в Application.Resources
                                 (в ресурсах окна или страницы он бы внутрь шаблона данных
                                 не достал). -->
                            <!-- Сортировки у колонки нет намеренно. Пока она была, щелчок
                                 по пустой шапке переставлял разделы по отметкам — и таблица,
                                 которая читается только по возрастанию адреса, оказывалась
                                 перемешанной, а колонка «Номер» переставала совпадать
                                 с порядком строк. -->
                            <DataGridTemplateColumn Width="40" CanUserSort="False">
                                <DataGridTemplateColumn.Header>
                                    <!-- Общая отметка вместо двух кнопок над таблицей.
                                         IsThreeState="False": щелчок переводит только между
                                         «все» и «ни одного», а состояние «часть» приходит
                                         от самих строк — привязка сама выставит его.

                                         Источник указан прямо, а не взят из DataContext:
                                         содержимое Header принадлежит колонке, а колонка
                                         в визуальном дереве не стоит — ни DataContext
                                         страницы, ни RelativeSource до неё не доходят,
                                         и галочка оставалась ни к чему не привязанной.
                                         ViewModel вкладки — singleton (см. TabViewModels),
                                         так что ссылаться на неё напрямую можно. -->
                                    <CheckBox IsThreeState="False" Padding="0"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Extract_SelectAllTooltip}"
                                              IsChecked="{Binding AllSelected, Mode=TwoWay,
                                                          Source={x:Static vm:TabViewModels.ExtractTab}}"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- Padding обнулён: у CheckBox из WPF-UI он по умолчанию
                                             11,5,11,6 и в шаблоне идёт Margin'ом вокруг всего,
                                             включая квадратик. При квадратике в 20px это 42px
                                             ширины в колонке на 40 — галочку прижимало бы
                                             краями ячейки. -->
                                        <CheckBox IsChecked="{Binding Selected}" Padding="0"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:Loc Extract_ColumnNumber}" Binding="{Binding Number}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="{loc:Loc Extract_ColumnOffset}" Binding="{Binding Offset}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="{loc:Loc Extract_ColumnLength}" Binding="{Binding Length}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="{loc:Loc Extract_ColumnFs}" Binding="{Binding FileSystem}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="{loc:Loc Extract_ColumnName}" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="{loc:Loc Extract_ColumnBadBlocks}" Binding="{Binding BadBlocks}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="{loc:Loc Extract_ColumnComment}" Binding="{Binding Comment}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Та же карточка журнала, что на остальных вкладках. Раньше здесь была своя
                 копия её разметки: список без прилипания к последней строке, без
                 копирования по Ctrl+C и без отложенной прокрутки — то есть без всего,
                 что в LogCard и написано. -->
            <c:LogCard/>

        </StackPanel>
    </ScrollViewer>
</Page>
