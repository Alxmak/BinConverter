<ui:FluentWindow x:Class="TweakFirmware.Views.ShellWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:TweakFirmware.Views"
                 xmlns:services="clr-namespace:TweakFirmware.Services"
                 xmlns:loc="clr-namespace:TweakFirmware.Services"
                 Title="{loc:Loc Shell_WindowTitle}"
                 Icon="pack://application:,,,/Assets/AppIcon-64.png"
                 Height="860" Width="1280" MinHeight="600" MinWidth="900"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <!-- Общий стиль кнопки лежит в Styles/AppStyles.xaml; здесь только уменьшаем
             отступы — кнопки баннера обновления компактнее, чем на рабочих вкладках. -->
        <Style x:Key="BannerButtonStyle" TargetType="Button" BasedOn="{StaticResource SolidButtonStyle}">
            <Setter Property="Padding" Value="14,7"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Иконка заголовка берётся из кадра на 32, а не на 64: заголовок рисует её
             в 16 точек, то есть уменьшает вдвое при обычном масштабе и не уменьшает
             вовсе при 200%. С 64-м кадром уменьшение было вчетверо и давало мыло.
             Иконка самого окна (атрибут Icon выше) остаётся 64-й: её Windows просит
             и мелкой для панели задач, и крупной для Alt+Tab. -->
        <ui:TitleBar Grid.Row="0" Title="{loc:Loc Shell_TitleBarTitle}" Icon="{ui:ImageIcon 'pack://application:,,,/Assets/AppIcon-32.png'}">
            <!-- Своя кнопка меню вместо встроенной. Встроенная живёт внутри самой панели,
                 а панель теперь прячется целиком — вместе с ней исчезла бы и кнопка,
                 и развернуть меню было бы нечем. Здесь же она видна всегда.
                 Символ вписан текстом, а не значком WPF-UI: у гамбургера в наборе
                 нет очевидного имени, а ☰ есть в системных шрифтах Windows. -->
            <ui:TitleBar.Header>
                <Button x:Name="MenuToggleButton" Content="&#x2630;" FontSize="15"
                        Background="Transparent" BorderThickness="0" Padding="10,4" Margin="6,0,0,0"
                        Cursor="Hand" ToolTip="{loc:Loc Shell_MenuToggleTooltip}"
                        Click="MenuToggle_Click" MouseEnter="MenuToggle_MouseEnter"
                        MouseLeave="MenuToggle_MouseLeave"/>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Баннер автообновления: своя DataContext (UpdateManager), не зависит от
             OperationLockService, который используется остальным окном. -->
        <Border Grid.Row="1" DataContext="{x:Static services:UpdateManager.Instance}"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                Padding="20,10"
                Visibility="{Binding ShowUpdateBanner, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Баннер проходит три состояния: «доступна версия» → «загрузка N%» →
                     «загружено, установить». Полоса не модальная и работать не мешает,
                     установка запускается только по явному нажатию. -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding BannerText}" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <!-- Пока идёт конвертирование/сборка/проверка, кнопка установки неактивна —
                         объясняем, почему, чтобы это не выглядело поломкой. -->
                    <TextBlock Text="{loc:Loc Shell_UpdateWaitingForOperation}" FontSize="12" Margin="0,2,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding IsWaitingForOperation, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{loc:Loc Shell_UpdateDownloadButton}" Command="{Binding DownloadCommand}"
                            Style="{StaticResource BannerButtonStyle}" Background="#2F6FED" Margin="0,0,8,0"
                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="{loc:Loc Common_CancelButton}" Command="{Binding CancelDownloadCommand}"
                            Padding="14,7" Margin="0,0,8,0"
                            Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="{loc:Loc Shell_UpdateInstallButton}" Command="{Binding InstallCommand}"
                            Style="{StaticResource BannerButtonStyle}" Background="#2F6FED" Margin="0,0,8,0"
                            Visibility="{Binding IsReadyToInstall, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="{loc:Loc Shell_LaterButton}" Command="{Binding PostponeCommand}" Padding="14,7"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Свёрнутое меню прячется целиком, а не остаётся столбцом значков: значки без
             подписей всё равно ничего не говорят, а заголовки групп рядом с ними
             превращались в обрубки. Прячет и разворачивает панель кнопка в заголовке
             окна (IsPaneToggleVisible=False — встроенная кнопка отключена, она внутри
             самой панели и исчезла бы вместе с ней).

             Ширина свёрнутой панели — 0. Это единственный работающий рычаг: свойство
             IsPaneVisible в WPF-UI 4.3 объявлено, но ни один шаблон его не читает —
             переключение не делало ровным счётом ничего. -->
        <ui:NavigationView Grid.Row="2" x:Name="RootNavigation"
                            IsBackButtonVisible="Collapsed"
                            IsPaneToggleVisible="False"
                            CompactPaneLength="0"
                            OpenPaneLength="210">

            <ui:NavigationView.Resources>
                <!-- Пункты меню — серифным шрифтом (по образцу дизайна Claude), с фолбэком
                     на стандартные шрифты Windows, если Cambria/Georgia недоступны. Цветовая
                     гамма (акцент, фон выделенного пункта) — из текущей темы приложения,
                     не переопределяется: WPF-UI сам привязывает подсветку выбранного пункта
                     к системному/акцентному цвету темы. -->
                <Style TargetType="{x:Type ui:NavigationViewItem}">
                    <Setter Property="FontFamily" Value="Cambria, Georgia, Times New Roman"/>
                    <Style.Triggers>
                        <!-- Свёрнутая панель должна исчезать целиком. Нулевой ширины для
                             этого мало: панель не обрезает содержимое по своей границе,
                             и значки пунктов продолжали рисоваться поверх страницы
                             узким столбцом. Прячем сами пункты. -->
                        <DataTrigger Value="False"
                                     Binding="{Binding IsPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type ui:NavigationView}}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
                <!-- BasedOn здесь обязателен, и это не формальность: у WPF-UI стиль
                     заголовка группы объявлен неявным (ключ — сам тип), а у пункта меню
                     именованным (NavigationViewItemDefaultStyle). Поэтому наш стиль пункта
                     library-стиль не трогает, а стиль заголовка — вытеснял его целиком,
                     вместе с Template. Контрол без шаблона не рисует ничего: подписи групп
                     не было видно ни на светлой теме, ни на тёмной, а Margin отсюда
                     продолжал занимать место — оставались пустые промежутки.
                     Прозрачность 0.7, а не 0.5: подпись должна читаться, а не угадываться.

                     Отступ слева — 8, и это подобранное число, а не расчёт: свои метрики
                     WPF-UI держит в скомпилированном BAML, прочитать оттуда левый вылет
                     значка пункта нельзя. Известны две точки: с 12 подпись вставала правее
                     значков, без отступа — заметно левее. Правка отступа влияет только на
                     подписи групп: у пунктов меню свой отступ, из шаблона библиотеки. -->
                <Style TargetType="{x:Type ui:NavigationViewItemHeader}"
                       BasedOn="{StaticResource {x:Type ui:NavigationViewItemHeader}}">
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Opacity" Value="0.7"/>
                    <Setter Property="Margin" Value="8,14,0,4"/>
                    <Style.Triggers>
                        <!-- В свёрнутой панели подписи групп не прячутся сами: у пунктов
                             меню текст убирает шаблон библиотеки, а у заголовка такого
                             поведения нет, и от «РАБОТА С ФАЙЛАМИ» оставался обрубок
                             «РАБО». Прячем сами.

                             Hidden с маленькой высотой, а не Collapsed: заголовок оставляет
                             после себя узкий промежуток, и группы значков видно как группы.
                             С Collapsed значки слились бы в сплошной столбец, а с одним
                             только Hidden (высота заголовка сохраняется целиком) между
                             ними зияли пустоты в треть экрана. -->
                        <DataTrigger Value="False"
                                     Binding="{Binding IsPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type ui:NavigationView}}}">
                            <Setter Property="Visibility" Value="Hidden"/>
                            <Setter Property="Height" Value="6"/>
                            <Setter Property="Margin" Value="0,6,0,0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ui:NavigationView.Resources>

            <!-- Пункт 5: пока где-то идёт операция (IsNotBusy=false), пункты меню недоступны —
                 переключение раздела больше не может сорвать активный процесс.
                 Сгруппировано по образцу дизайна Claude: заголовки групп + разделитель. -->
            <ui:NavigationView.MenuItems>
                <!-- Разделы стоят парами «прямая операция — обратная»: нарезка и сборка
                     файла в одной группе, извлечение и объединение разделов в другой.
                     Сама по себе только проверка SHA-256 — ей отдельная группа «Разное»,
                     иначе она оказывается в чужой паре и читается как её продолжение. -->
                <ui:NavigationViewItemHeader Text="{loc:Loc Shell_FilesGroupHeader}"/>
                <ui:NavigationViewItem Content="{loc:Loc Shell_NavConvert}" Icon="{ui:SymbolIcon ArrowSplit24}"
                                        TargetPageType="{x:Type views:ConvertPage}"
                                        IsEnabled="{Binding IsNotBusy}"/>
                <ui:NavigationViewItem Content="{loc:Loc Shell_NavMerge}" Icon="{ui:SymbolIcon ArrowJoin20}"
                                        TargetPageType="{x:Type views:MergePage}"
                                        IsEnabled="{Binding IsNotBusy}"/>

                <ui:NavigationViewItemHeader Text="{loc:Loc Shell_PartitionsGroupHeader}"/>
                <!-- Единственный пункт с составной подписью: «Beta» надо поднять над
                     строкой и покрасить, а одной строкой Content этого не задать.
                     Цвет основной части берётся у самого пункта: у него он меняется
                     вместе с темой и состоянием, а вложенному TextBlock по наследованию
                     доезжает не всегда — про это же сказано в AppStyles.xaml.
                     TargetPageTag задан явно: WPF-UI выводит его из Content.ToString(),
                     и для нестроки получилось бы имя типа. -->
                <ui:NavigationViewItem Icon="{ui:SymbolIcon Archive24}"
                                        TargetPageType="{x:Type views:ExtractPage}"
                                        TargetPageTag="extract"
                                        IsEnabled="{Binding IsNotBusy}">
                    <ui:NavigationViewItem.Content>
                        <!-- Оба Run стоят вплотную намеренно: перенос строки между
                             ними XAML превратил бы в лишний пробел. Отступ перед
                             «Beta» задан в самом тексте. -->
                        <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ui:NavigationViewItem}}}"><Run Text="{loc:Loc Shell_NavExtract}"/><Run Text=" Beta" BaselineAlignment="Superscript" FontSize="8.5" Foreground="{StaticResource BetaBadgeBrush}"/></TextBlock>
                    </ui:NavigationViewItem.Content>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{loc:Loc Shell_NavPartitionMerge}" Icon="{ui:SymbolIcon ArrowJoin20}"
                                        TargetPageType="{x:Type views:PartitionMergePage}"
                                        IsEnabled="{Binding IsNotBusy}"/>

                <ui:NavigationViewItemHeader Text="{loc:Loc Shell_MiscGroupHeader}"/>
                <ui:NavigationViewItem Content="{loc:Loc Shell_NavVerify}" Icon="{ui:SymbolIcon CheckmarkCircle24}"
                                        TargetPageType="{x:Type views:VerifyPage}"
                                        IsEnabled="{Binding IsNotBusy}"/>

                <!-- Разделителя перед «Системой» больше нет: группы и так разведены
                     заголовками, а в свёрнутой панели он оставался единственным, что
                     рисовалось, — тонкой линией слева поверх страницы (панель не
                     обрезает содержимое по своей нулевой ширине). -->
                <ui:NavigationViewItemHeader Text="{loc:Loc Shell_SystemGroupHeader}"/>
                <ui:NavigationViewItem Content="{loc:Loc Shell_NavSettings}" Icon="{ui:SymbolIcon Settings24}"
                                        TargetPageType="{x:Type views:SettingsPage}"
                                        IsEnabled="{Binding IsNotBusy}"/>
                <ui:NavigationViewItem Content="{loc:Loc Shell_NavAbout}" Icon="{ui:SymbolIcon Info24}"
                                        TargetPageType="{x:Type views:AboutPage}"
                                        IsEnabled="{Binding IsNotBusy}"/>
            </ui:NavigationView.MenuItems>

        </ui:NavigationView>

        <!-- Всплывающее меню при наведении на кнопку. Popup, а не сама панель: панель
             встроена в раскладку окна и, открываясь, сдвигает страницу вправо, а
             подсматривать разделы хочется поверх содержимого, ничего не двигая.

             Содержимое собирается кодом из тех же RootNavigation.MenuItems (см.
             BuildPeekMenu): второй список разделов в разметке рано или поздно разошёлся
             бы с первым — добавили раздел в меню, забыли во всплывающем.

             Закрывается он по уходу мыши — и с кнопки, и с себя, — а также по щелчку
             по пункту, по кнопке и при уходе из окна. -->
        <!-- Список висит под кнопкой меню. Отступ сверху задаётся не здесь, а в коде
             (MenuToggle_MouseEnter): он должен совпадать с отступом слева, а слева тот
             получается из положения кнопки в полосе заголовка — числом его не записать.

             StaysOpen="True" обязательно. При False всплывающее окно захватывает мышь,
             чтобы ловить щелчки мимо себя, — и события мыши перестают доходить до кнопки.
             Из-за этого кнопка не получала MouseLeave (список оставался висеть навсегда),
             а всплывающая подсказка кнопки не получала сигнала закрыться: она появлялась
             с опозданием уже там, куда мышь успела уехать, и оставалась на экране. -->
        <Popup x:Name="MenuPeek" StaysOpen="True" AllowsTransparency="True"
               PlacementTarget="{Binding ElementName=MenuToggleButton}" Placement="Bottom"
               HorizontalOffset="4"
               MouseEnter="MenuPeek_MouseEnter" MouseLeave="MenuPeek_MouseLeave">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="6" MinWidth="210" Margin="0,0,10,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.18" Color="Black"/>
                </Border.Effect>
                <StackPanel x:Name="MenuPeekItems"/>
            </Border>
        </Popup>
    </Grid>
</ui:FluentWindow>
