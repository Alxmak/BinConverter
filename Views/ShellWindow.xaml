<ui:FluentWindow x:Class="TweakFirmware.Views.ShellWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:TweakFirmware.Views"
                 xmlns:services="clr-namespace:TweakFirmware.Services"
                 xmlns:loc="clr-namespace:TweakFirmware.Services"
                 Title="{loc:Loc Shell_WindowTitle}"
                 Icon="pack://application:,,,/Assets/AppIcon-64.png"
                 Height="860" Width="1280" MinHeight="600" MinWidth="900"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <!-- Общий стиль кнопки лежит в Styles/AppStyles.xaml; здесь только уменьшаем
             отступы — кнопки баннера обновления компактнее, чем на рабочих вкладках. -->
        <Style x:Key="BannerButtonStyle" TargetType="Button" BasedOn="{StaticResource SolidButtonStyle}">
            <Setter Property="Padding" Value="14,7"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{loc:Loc Shell_TitleBarTitle}" Icon="{ui:ImageIcon 'pack://application:,,,/Assets/AppIcon-64.png'}"/>

        <!-- Баннер автообновления: своя DataContext (UpdateManager), не зависит от
             OperationLockService, который используется остальным окном. -->
        <Border Grid.Row="1" DataContext="{x:Static services:UpdateManager.Instance}"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                Padding="20,10"
                Visibility="{Binding ShowUpdateBanner, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Баннер проходит три состояния: «доступна версия» → «загрузка N%» →
                     «загружено, установить». Полоса не модальная и работать не мешает,
                     установка запускается только по явному нажатию. -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding BannerText}" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <!-- Пока идёт конвертирование/сборка/проверка, кнопка установки неактивна —
                         объясняем, почему, чтобы это не выглядело поломкой. -->
                    <TextBlock Text="{loc:Loc Shell_UpdateWaitingForOperation}" FontSize="12" Margin="0,2,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding IsWaitingForOperation, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{loc:Loc Shell_UpdateDownloadButton}" Command="{Binding DownloadCommand}"
                            Style="{StaticResource BannerButtonStyle}" Background="#2F6FED" Margin="0,0,8,0"
                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="{loc:Loc Common_CancelButton}" Command="{Binding CancelDownloadCommand}"
                            Padding="14,7" Margin="0,0,8,0"
                            Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="{loc:Loc Shell_UpdateInstallButton}" Command="{Binding InstallCommand}"
                            Style="{StaticResource BannerButtonStyle}" Background="#2F6FED" Margin="0,0,8,0"
                            Visibility="{Binding IsReadyToInstall, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="{loc:Loc Shell_LaterButton}" Command="{Binding PostponeCommand}" Padding="14,7"/>
                </StackPanel>
            </Grid>
        </Border>

        <ui:NavigationView Grid.Row="2" x:Name="RootNavigation"
                            IsBackButtonVisible="Collapsed"
                            IsPaneToggleVisible="True"
                            OpenPaneLength="210">

            <ui:NavigationView.Resources>
                <!-- Пункты меню — серифным шрифтом (по образцу дизайна Claude), с фолбэком
                     на стандартные шрифты Windows, если Cambria/Georgia недоступны. Цветовая
                     гамма (акцент, фон выделенного пункта) — из текущей темы приложения,
                     не переопределяется: WPF-UI сам привязывает подсветку выбранного пункта
                     к системному/акцентному цвету темы. -->
                <Style TargetType="{x:Type ui:NavigationViewItem}">
                    <Setter Property="FontFamily" Value="Cambria, Georgia, Times New Roman"/>
                </Style>
                <Style TargetType="{x:Type ui:NavigationViewItemHeader}">
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Opacity" Value="0.5"/>
                    <Setter Property="Margin" Value="12,14,12,4"/>
                </Style>
            </ui:NavigationView.Resources>

            <!-- Пункт 5: пока где-то идёт операция (IsNotBusy=false), пункты меню недоступны —
                 переключение раздела больше не может сорвать активный процесс.
                 Сгруппировано по образцу дизайна Claude: заголовки групп + разделитель. -->
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItemHeader Text="{loc:Loc Shell_ToolsGroupHeader}"/>
                <ui:NavigationViewItem Content="{loc:Loc Shell_NavConvert}" Icon="{ui:SymbolIcon ArrowSplit24}"
                                        TargetPageType="{x:Type views:ConvertPage}"
                                        IsEnabled="{Binding IsNotBusy}"/>
                <ui:NavigationViewItem Content="{loc:Loc Shell_NavMerge}" Icon="{ui:SymbolIcon ArrowJoin20}"
                                        TargetPageType="{x:Type views:MergePage}"
                                        IsEnabled="{Binding IsNotBusy}"/>
                <ui:NavigationViewItem Content="{loc:Loc Shell_NavVerify}" Icon="{ui:SymbolIcon CheckmarkCircle24}"
                                        TargetPageType="{x:Type views:VerifyPage}"
                                        IsEnabled="{Binding IsNotBusy}"/>
                <ui:NavigationViewItem Content="{loc:Loc Shell_NavExtract}" Icon="{ui:SymbolIcon Info24}"
                                        TargetPageType="{x:Type views:ExtractPage}"
                                        IsEnabled="{Binding IsNotBusy}"/>
                <ui:NavigationViewItem Content="{loc:Loc Shell_NavTerminal}" Icon="{ui:SymbolIcon Info24}"
                                        TargetPageType="{x:Type views:TerminalPage}"
                                        IsEnabled="{Binding IsNotBusy}"/>
                <ui:NavigationViewItemSeparator/>
                <ui:NavigationViewItemHeader Text="{loc:Loc Shell_SystemGroupHeader}"/>
                <ui:NavigationViewItem Content="{loc:Loc Shell_NavSettings}" Icon="{ui:SymbolIcon Settings24}"
                                        TargetPageType="{x:Type views:SettingsPage}"
                                        IsEnabled="{Binding IsNotBusy}"/>
                <ui:NavigationViewItem Content="{loc:Loc Shell_NavAbout}" Icon="{ui:SymbolIcon Info24}"
                                        TargetPageType="{x:Type views:AboutPage}"
                                        IsEnabled="{Binding IsNotBusy}"/>
            </ui:NavigationView.MenuItems>

        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
