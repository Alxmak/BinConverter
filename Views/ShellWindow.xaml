<ui:FluentWindow x:Class="TweakFirmware.Views.ShellWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:TweakFirmware.Views"
                 xmlns:c="clr-namespace:TweakFirmware.Controls"
                 xmlns:services="clr-namespace:TweakFirmware.Services"
                 xmlns:loc="clr-namespace:TweakFirmware.Services"
                 Title="{loc:Loc Common_AppName}"
                 Icon="pack://application:,,,/Assets/AppIcon-64.png"
                 Height="860" Width="1280" MinHeight="600" MinWidth="900"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True">

    <!-- Полоса прогресса прямо на кнопке в панели задач. Операции здесь идут десятками
         минут, и окно на это время сворачивают — а свёрнутое окно не сообщало ровно
         ничего: чтобы узнать, работает программа или давно закончила, приходилось её
         разворачивать. Цвет говорит о состоянии: обычный — идёт, жёлтый — пауза,
         красный — кончилось не тем, чего ждали.

         Источник указан явно, а не взят из DataContext окна (там лежит та же служба).
         TaskbarItemInfo — не элемент разметки, а Freezable, и в логическом дереве окна
         не стоит: DataContext до него доходит не всегда, и привязка молча осталась бы
         пустой. -->
    <ui:FluentWindow.TaskbarItemInfo>
        <TaskbarItemInfo
            ProgressValue="{Binding TaskbarProgress, Source={x:Static services:OperationLockService.Instance}}"
            ProgressState="{Binding TaskbarState, Source={x:Static services:OperationLockService.Instance}}"/>
    </ui:FluentWindow.TaskbarItemInfo>

    <ui:FluentWindow.Resources>
        <!-- Общий стиль кнопки лежит в Styles/AppStyles.xaml; здесь только уменьшаем
             отступы — кнопки баннера обновления компактнее, чем на рабочих вкладках. -->
        <Style x:Key="BannerButtonStyle" TargetType="Button" BasedOn="{StaticResource SolidButtonStyle}">
            <Setter Property="Padding" Value="14,7"/>
        </Style>

        <!-- Пункт всплывающего списка разделов (свёрнутое меню). Свой шаблон, а не
             библиотечный, из-за подсветки под мышью: WPF-UI берёт для неё
             ControlFillColorSecondary, а это в светлой теме полупрозрачный почти белый
             (#80F9F9F9) поверх почти белой карточки — подсветки фактически не видно.
             В тёмной теме тот же ключ даёт белый по тёмному и читается отлично, поэтому
             и заметно было только на светлой.

             Своей пары кистей под каждую тему заводить не стали: серый с прозрачностью
             работает в обеих — на белом он темнее фона, на тёмном светлее. -->
        <Style x:Key="PeekMenuItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Cambria, Georgia, Times New Roman"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#24808080"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#33808080"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Логотип нарисован своим Image в шапке заголовка, а не задан свойством Icon.
             Свойство не подошло: в шаблоне TitleBar из WPF-UI под значок отведён
             ContentPresenter с жёстко прописанной высотой в 16 точек, и значок крупнее
             туда не помещается — он вылезал бы за отведённое место, а разметка про
             это не знала бы. В 16 точек логотип не читается: видно, что что-то синее,
             а что именно — нет.

             Padding заголовка обнулён по той же причине: он задаёт отступ той самой
             колонке под Icon, а она теперь пустая и оставляла бы слева дыру. Отступ
             логотипа от края задан ему самому и равен прежнему.

             Кадр на 64, а не на 32 или 256: при обычном масштабе он уменьшается ровно
             вдвое, при 200% рисуется один к одному — оба случая без дробного пересчёта.
             Кадр на 32 пришлось бы растягивать уже при 150%, а 256 — уменьшать
             в восемь раз. Иконка самого окна (атрибут Icon выше) остаётся 64-й:
             её Windows просит и мелкой для панели задач, и крупной для Alt+Tab. -->
        <ui:TitleBar Grid.Row="0" Title="{loc:Loc Common_AppName}" Padding="0">
            <ui:TitleBar.Header>
                <!-- Полоса тянется на всю высоту заголовка намеренно: так кнопка меню
                     остаётся ровно той же высоты, что была, когда стояла в шапке одна.
                     Логотип внутри выровнен по центру сам. -->
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/AppIcon-64.png" Width="32" Height="32"
                           Margin="16,0,4,0" Stretch="Uniform" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- Своя кнопка меню вместо встроенной. Встроенная живёт внутри самой
                         панели, а панель теперь прячется целиком — вместе с ней исчезла бы
                         и кнопка, и развернуть меню было бы нечем. Здесь же она видна всегда.
                         Символ вписан текстом, а не значком WPF-UI: у гамбургера в наборе
                         нет очевидного имени, а ☰ есть в системных шрифтах Windows. -->
                    <Button x:Name="MenuToggleButton" Content="&#x2630;" FontSize="15"
                            Background="Transparent" BorderThickness="0" Padding="10,4" Margin="6,0,0,0"
                            Cursor="Hand" ToolTip="{loc:Loc Shell_MenuToggleTooltip}"
                            Click="MenuToggle_Click" MouseEnter="MenuToggle_MouseEnter"
                            MouseLeave="MenuToggle_MouseLeave"/>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Баннер автообновления: своя DataContext (UpdateManager), не зависит от
             OperationLockService, который используется остальным окном. -->
        <Border Grid.Row="1" DataContext="{x:Static services:UpdateManager.Instance}"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                Padding="20,10"
                Visibility="{Binding ShowUpdateBanner, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Баннер проходит три состояния: «доступна версия» → «загрузка N%» →
                     «загружено, установить». Полоса не модальная и работать не мешает,
                     установка запускается только по явному нажатию. -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding BannerText}" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <!-- Пока идёт конвертирование/сборка/проверка, кнопка установки неактивна —
                         объясняем, почему, чтобы это не выглядело поломкой. -->
                    <TextBlock Text="{loc:Loc Shell_UpdateWaitingForOperation}" FontSize="12" Margin="0,2,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding IsWaitingForOperation, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{loc:Loc Shell_UpdateDownloadButton}" Command="{Binding DownloadCommand}"
                            Style="{StaticResource BannerButtonStyle}" Background="#2F6FED" Margin="0,0,8,0"
                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="{loc:Loc Common_CancelButton}" Command="{Binding CancelDownloadCommand}"
                            Padding="14,7" Margin="0,0,8,0"
                            Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="{loc:Loc Shell_UpdateInstallButton}" Command="{Binding InstallCommand}"
                            Style="{StaticResource BannerButtonStyle}" Background="#2F6FED" Margin="0,0,8,0"
                            Visibility="{Binding IsReadyToInstall, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="{loc:Loc Shell_LaterButton}" Command="{Binding PostponeCommand}" Padding="14,7"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Свёрнутое меню прячется целиком, а не остаётся столбцом значков: значки без
             подписей всё равно ничего не говорят, а заголовки групп рядом с ними
             превращались в обрубки. Прячет и разворачивает панель кнопка в заголовке
             окна (IsPaneToggleVisible=False — встроенная кнопка отключена, она внутри
             самой панели и исчезла бы вместе с ней).

             Ширина свёрнутой панели — 0. Это единственный работающий рычаг: свойство
             IsPaneVisible в WPF-UI 4.3 объявлено, но ни один шаблон его не читает —
             переключение не делало ровным счётом ничего. -->
        <ui:NavigationView Grid.Row="2" x:Name="RootNavigation"
                            IsBackButtonVisible="Collapsed"
                            IsPaneToggleVisible="False"
                            CompactPaneLength="0"
                            OpenPaneLength="210">

            <ui:NavigationView.Resources>
                <!-- Пункты меню — серифным шрифтом (по образцу дизайна Claude), с фолбэком
                     на стандартные шрифты Windows, если Cambria/Georgia недоступны. Цветовая
                     гамма (акцент, фон выделенного пункта) — из текущей темы приложения,
                     не переопределяется: WPF-UI сам привязывает подсветку выбранного пункта
                     к системному/акцентному цвету темы. -->
                <Style TargetType="{x:Type ui:NavigationViewItem}">
                    <Setter Property="FontFamily" Value="Cambria, Georgia, Times New Roman"/>
                    <Style.Triggers>
                        <!-- Свёрнутая панель должна исчезать целиком. Нулевой ширины для
                             этого мало: панель не обрезает содержимое по своей границе,
                             и значки пунктов продолжали рисоваться поверх страницы
                             узким столбцом. Прячем сами пункты. -->
                        <DataTrigger Value="False"
                                     Binding="{Binding IsPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type ui:NavigationView}}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
                <!-- BasedOn здесь обязателен, и это не формальность: у WPF-UI стиль
                     заголовка группы объявлен неявным (ключ — сам тип), а у пункта меню
                     именованным (NavigationViewItemDefaultStyle). Поэтому наш стиль пункта
                     library-стиль не трогает, а стиль заголовка — вытеснял его целиком,
                     вместе с Template. Контрол без шаблона не рисует ничего: подписи групп
                     не было видно ни на светлой теме, ни на тёмной, а Margin отсюда
                     продолжал занимать место — оставались пустые промежутки.
                     Прозрачность 0.7, а не 0.5: подпись должна читаться, а не угадываться.

                     Отступ слева — 8, и это подобранное число, а не расчёт: свои метрики
                     WPF-UI держит в скомпилированном BAML, прочитать оттуда левый вылет
                     значка пункта нельзя. Известны две точки: с 12 подпись вставала правее
                     значков, без отступа — заметно левее. Правка отступа влияет только на
                     подписи групп: у пунктов меню свой отступ, из шаблона библиотеки. -->
                <Style x:Key="GroupHeaderStyle" TargetType="{x:Type ui:NavigationViewItemHeader}"
                       BasedOn="{StaticResource {x:Type ui:NavigationViewItemHeader}}">
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Opacity" Value="0.7"/>
                    <Setter Property="Margin" Value="8,14,0,4"/>
                    <Style.Triggers>
                        <!-- В свёрнутой панели подписи групп не прячутся сами: у пунктов
                             меню текст убирает шаблон библиотеки, а у заголовка такого
                             поведения нет, и от «РАБОТА С ФАЙЛАМИ» оставался обрубок
                             «РАБО». Прячем сами.

                             Hidden с маленькой высотой, а не Collapsed: заголовок оставляет
                             после себя узкий промежуток, и группы значков видно как группы.
                             С Collapsed значки слились бы в сплошной столбец, а с одним
                             только Hidden (высота заголовка сохраняется целиком) между
                             ними зияли пустоты в треть экрана. -->
                        <DataTrigger Value="False"
                                     Binding="{Binding IsPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type ui:NavigationView}}}">
                            <Setter Property="Visibility" Value="Hidden"/>
                            <Setter Property="Height" Value="6"/>
                            <Setter Property="Margin" Value="0,6,0,0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>

                <!-- Тот же стиль без ключа — чтобы применялся ко всем заголовкам сам. -->
                <Style TargetType="{x:Type ui:NavigationViewItemHeader}" BasedOn="{StaticResource GroupHeaderStyle}"/>

                <!-- Заголовок группы с пометкой «Beta» — сейчас это «Работа с разделами».
                     Пометка стояла у самого пункта «Извлечение разделов» надстрочным
                     красным текстом; у группы она заметнее и не ломает подпись пункта
                     на два куска (из-за этого раздел когда-то пропадал из всплывающего
                     списка — см. TextOf в ShellWindow.xaml.cs).

                     Заголовок — не ContentControl: у него есть только Text и Icon,
                     положить рядом что-то своё можно лишь своим шаблоном. Шаблон
                     повторяет библиотечный (WPF-UI 4.3.0) — те же колонки и привязки,
                     добавлена третья колонка под плашку. Расходиться ему не с чем:
                     версия библиотеки закреплена в csproj. -->
                <Style x:Key="BetaGroupHeaderStyle" TargetType="{x:Type ui:NavigationViewItemHeader}"
                       BasedOn="{StaticResource GroupHeaderStyle}">
                    <!-- Приглушение переезжает с заголовка на его подпись. Прозрачность
                         действует на всё поддерево, и плашка выцветала вместе с текстом:
                         рядом с такой же плашкой версии в «О программе» она выглядела
                         блёклой. Подпись остаётся приглушённой, как у остальных групп. -->
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ui:NavigationViewItemHeader}">
                                <Grid Margin="{TemplateBinding Margin}"
                                      HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalAlignment}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter x:Name="IconElement" Grid.Column="0" Margin="0,0,4,0"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding Icon}"
                                                      TextElement.FontSize="{TemplateBinding FontSize}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>

                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Opacity="0.7"
                                               FontSize="{TemplateBinding FontSize}"
                                               Foreground="{TemplateBinding Foreground}"
                                               Text="{TemplateBinding Text}"/>

                                    <c:Badge Grid.Column="2" Text="{loc:Loc Common_BetaBadge}"
                                             FontSize="9" Padding="5,1,5,2"
                                             Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="Icon" Value="{x:Null}">
                                        <Setter TargetName="IconElement" Property="Margin" Value="0"/>
                                        <Setter TargetName="IconElement" Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ui:NavigationView.Resources>

            <!-- Пункт 5: пока где-то идёт операция (IsNotBusy=false), пункты меню недоступны —
                 переключение раздела больше не может сорвать активный процесс.
                 Сгруппировано по образцу дизайна Claude: заголовки групп + разделитель. -->

            <!-- NavigationCacheMode="Required" стоит у каждого пункта, и это не украшение.
                 По умолчанию в WPF-UI 4.3 у пункта меню Disabled, а это значит буквально
                 «строить страницу заново на каждый переход»: создание экземпляра через
                 рефлексию, разбор BAML, всё дерево целиком, все привязки ({loc:Loc} — это
                 отдельная привязка на каждую надпись) и полный проход разметки. Приходится
                 всё это ровно на 200 миллисекунд анимации появления, а считает её тот же
                 поток интерфейса — кадры пропускаются, и переход выглядит рывком.

                 Вторая половина беды в том, что ни одна построенная страница не
                 освобождалась. NavigationView кладёт каждую в PageToNavigationItemDictionary
                 (обычный словарь по экземпляру страницы, чистится только при закрытии окна),
                 а Frame журналирует навигацию по объекту как KeepAlive и тоже держит ссылку.
                 То есть на каждое переключение в памяти оставалось целое дерево страницы,
                 куча росла, а сборки мусора приходили по своему расписанию — отсюда
                 «подлагивает, но не всегда».

                 С Required страница строится один раз и дальше переиспользуется. На
                 поведении это не сказывается: состояние вкладок и так живёт дольше страниц
                 (см. TabViewModels), а Loaded/Unloaded при переходах приходят по-прежнему,
                 так что Attach/Detach работают как работали. Поправить отдельно пришлось
                 одно место — общую высоту журнала, см. LogCard. -->
            <ui:NavigationView.MenuItems>
                <!-- Разделы стоят парами «прямая операция — обратная»: нарезка и сборка
                     файла в одной группе, извлечение и объединение разделов в другой.
                     Сама по себе только проверка SHA-256 — ей отдельная группа «Разное»,
                     иначе она оказывается в чужой паре и читается как её продолжение. -->
                <ui:NavigationViewItemHeader Text="{loc:Loc Shell_FilesGroupHeader}"/>
                <ui:NavigationViewItem Content="{loc:Loc Shell_NavConvert}" Icon="{ui:SymbolIcon ArrowSplit24}"
                                        TargetPageType="{x:Type views:ConvertPage}"
                                        NavigationCacheMode="Required"
                                        IsEnabled="{Binding IsNotBusy}"/>
                <ui:NavigationViewItem Content="{loc:Loc Shell_NavMerge}" Icon="{ui:SymbolIcon ArrowJoin20}"
                                        TargetPageType="{x:Type views:MergePage}"
                                        NavigationCacheMode="Required"
                                        IsEnabled="{Binding IsNotBusy}"/>

                <!-- Пометка «Beta» — у всей группы, а не у одного пункта: проверять
                     на настоящих дампах надо и извлечение, и обратное объединение. -->
                <ui:NavigationViewItemHeader Text="{loc:Loc Shell_PartitionsGroupHeader}"
                                             Style="{StaticResource BetaGroupHeaderStyle}"/>
                <!-- TargetPageTag здесь больше не нужен: он задавался вручную, пока
                     подпись была не строкой, а TextBlock из двух Run (WPF-UI выводит
                     тег из Content.ToString(), и получалось имя типа). Переходов
                     по тегу в программе нет — навигация идёт по типу страницы. -->
                <ui:NavigationViewItem Content="{loc:Loc Shell_NavExtract}" Icon="{ui:SymbolIcon Archive24}"
                                        TargetPageType="{x:Type views:ExtractPage}"
                                        NavigationCacheMode="Required"
                                        IsEnabled="{Binding IsNotBusy}"/>
                <ui:NavigationViewItem Content="{loc:Loc Shell_NavPartitionMerge}" Icon="{ui:SymbolIcon ArrowJoin20}"
                                        TargetPageType="{x:Type views:PartitionMergePage}"
                                        NavigationCacheMode="Required"
                                        IsEnabled="{Binding IsNotBusy}"/>

                <ui:NavigationViewItemHeader Text="{loc:Loc Shell_MiscGroupHeader}"/>
                <ui:NavigationViewItem Content="{loc:Loc Shell_NavVerify}" Icon="{ui:SymbolIcon CheckmarkCircle24}"
                                        TargetPageType="{x:Type views:VerifyPage}"
                                        NavigationCacheMode="Required"
                                        IsEnabled="{Binding IsNotBusy}"/>

                <!-- Разделителя перед «Системой» больше нет: группы и так разведены
                     заголовками, а в свёрнутой панели он оставался единственным, что
                     рисовалось, — тонкой линией слева поверх страницы (панель не
                     обрезает содержимое по своей нулевой ширине). -->
                <ui:NavigationViewItemHeader Text="{loc:Loc Shell_SystemGroupHeader}"/>
                <ui:NavigationViewItem Content="{loc:Loc Shell_NavSettings}" Icon="{ui:SymbolIcon Settings24}"
                                        TargetPageType="{x:Type views:SettingsPage}"
                                        NavigationCacheMode="Required"
                                        IsEnabled="{Binding IsNotBusy}"/>
                <ui:NavigationViewItem Content="{loc:Loc Shell_NavAbout}" Icon="{ui:SymbolIcon Info24}"
                                        TargetPageType="{x:Type views:AboutPage}"
                                        NavigationCacheMode="Required"
                                        IsEnabled="{Binding IsNotBusy}"/>
            </ui:NavigationView.MenuItems>

        </ui:NavigationView>

        <!-- Всплывающее меню при наведении на кнопку. Popup, а не сама панель: панель
             встроена в раскладку окна и, открываясь, сдвигает страницу вправо, а
             подсматривать разделы хочется поверх содержимого, ничего не двигая.

             Содержимое собирается кодом из тех же RootNavigation.MenuItems (см.
             BuildPeekMenu): второй список разделов в разметке рано или поздно разошёлся
             бы с первым — добавили раздел в меню, забыли во всплывающем.

             Закрывается он по уходу мыши — и с кнопки, и с себя, — а также по щелчку
             по пункту, по кнопке и при уходе из окна. -->
        <!-- Список висит под кнопкой меню. Отступ сверху задаётся не здесь, а в коде
             (MenuToggle_MouseEnter): он должен совпадать с отступом слева, а слева тот
             получается из положения кнопки в полосе заголовка — числом его не записать.

             StaysOpen="True" обязательно. При False всплывающее окно захватывает мышь,
             чтобы ловить щелчки мимо себя, — и события мыши перестают доходить до кнопки.
             Из-за этого кнопка не получала MouseLeave (список оставался висеть навсегда),
             а всплывающая подсказка кнопки не получала сигнала закрыться: она появлялась
             с опозданием уже там, куда мышь успела уехать, и оставалась на экране. -->
        <Popup x:Name="MenuPeek" StaysOpen="True" AllowsTransparency="True"
               PlacementTarget="{Binding ElementName=MenuToggleButton}" Placement="Bottom"
               HorizontalOffset="4"
               MouseEnter="MenuPeek_MouseEnter" MouseLeave="MenuPeek_MouseLeave">
            <!-- Фон и рамка — «плавающие» кисти библиотеки, а не карточные, и это не
                 придирка к оттенку.

                 Карточная кисть полупрозрачна по замыслу: CardBackgroundFillColorDefault —
                 это белый с прозрачностью 5% в тёмной теме и 70% в светлой. Карточке
                 такого хватает, потому что под ней лежит непрозрачное окно. А всплывающий
                 список — отдельное окно с AllowsTransparency, и под ним нет ничего: сквозь
                 него было видно ту самую страницу, поверх которой он открыт. В светлой
                 теме это выглядело как просвечивающие плитки со значками, в тёмной, где
                 остаётся 5% заливки, — как наложенный текст, который просто не прочитать.
                 От размера окна это не зависело: менялось лишь то, что оказывалось под
                 списком, и в развёрнутом окне туда попадала пустая часть страницы.

                 FlyoutBackground и FlyoutBorderBrush — то, чем библиотека красит
                 собственные меню и всплывающие панели. Обе кисти непрозрачны
                 (#2C2C2C в тёмной теме, #F9F9F9 в светлой) и есть в обеих темах;
                 в палитре они прямо помечены как «замена акрилу для всплывающих окон». -->
            <Border Background="{DynamicResource FlyoutBackground}"
                    BorderBrush="{DynamicResource FlyoutBorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="6" MinWidth="210" Margin="0,0,10,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.18" Color="Black"/>
                </Border.Effect>
                <StackPanel x:Name="MenuPeekItems"/>
            </Border>
        </Popup>
    </Grid>
</ui:FluentWindow>
