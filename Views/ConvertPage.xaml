<Page x:Class="TweakFirmware.Views.ConvertPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:TweakFirmware.Services"
      xmlns:c="clr-namespace:TweakFirmware.Controls"
      Title="{loc:Loc Convert_Title}"
      ScrollViewer.CanContentScroll="False">

    <!-- Esc отменяет идущую операцию. Enter на «Начать» намеренно не назначен: на этих
         страницах есть поля ввода, и нажатие Enter при правке пути запускало бы
         многочасовую запись на диск. -->
    <Page.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Page.InputBindings>

    <ScrollViewer x:Name="RootScroll" Padding="24,16" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="960" HorizontalAlignment="Stretch">

            <!-- Пока идёт конвертирование, поля ввода недоступны: менять исходник, папку
                 назначения или пресет на ходу нельзя — параметры разойдутся с уже
                 запущенным процессом. IsEnabled наследуется вглубь, поэтому достаточно
                 поставить его на карточку целиком. -->
            <!-- IsSharedSizeScope нужен колонке кнопок «Обзор»: по ней равняется пустая
                 колонка в строке лимита, чтобы поле байтов кончалось там же, где поля
                 путей над ним. Ширина кнопки зависит от языка («Обзор…» и «Browse…»
                 разной длины), поэтому повторить её числом нельзя. -->
            <Border Style="{StaticResource CardStyle}" IsEnabled="{Binding IsNotBusy}">
                <StackPanel Grid.IsSharedSizeScope="True">

                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="BrowseButton"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc Convert_SourceFileLabel}" Style="{StaticResource RowLabel}"/>
                        <!-- Перетаскивание принимает само поле, а не строка целиком.
                             Именно поле и есть цель, о которой говорит подсказка внутри
                             него; раньше AllowDrop стоял на строке, и файл принимался
                             мимо поля — над подписью и кнопкой, — а над полем нет:
                             TextBox сам обрабатывает перетаскивание (он ждёт текст)
                             и до строки событие не доходило. Preview-события нужны
                             ровно для этого: перехватить до его собственной обработки. -->
                        <ui:TextBox ClearButtonEnabled="False" Grid.Column="1" Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                    PlaceholderText="{loc:Loc Common_NoFileSelected}"
                                    AllowDrop="True" PreviewDragOver="SourceBox_DragOver" PreviewDrop="SourceBox_Drop"/>
                        <Button Grid.Column="2" Content="{loc:Loc Common_BrowseButton}" Command="{Binding BrowseSourceCommand}"/>
                    </Grid>

                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="BrowseButton"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc Common_DestinationFolderLabel}" Style="{StaticResource RowLabel}"/>
                        <ui:TextBox ClearButtonEnabled="False" Grid.Column="1" Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                    PlaceholderText="{loc:Loc Common_NoFolderSelected}"
                                    AllowDrop="True" PreviewDragOver="OutputBox_DragOver" PreviewDrop="OutputBox_Drop"/>
                        <Button Grid.Column="2" Content="{loc:Loc Common_BrowseButton}" Command="{Binding BrowseOutputCommand}"/>
                    </Grid>

                    <!-- Модель и лимит — в одной строке: лимит виден всегда, но правится
                         только на пользовательском пресете. У готовых моделей он фиксирован,
                         поэтому поле недоступно и просто показывает заданный лимит в байтах
                         (значение подставляет OnSelectedPresetChanged во ViewModel).

                         Колонки те же, что у «Общей информации» и «Параметров» под карточкой
                         (`*`, 14, `*`): у карточки отступы по 18 с обеих сторон, поэтому
                         половины внутри неё приходятся ровно на края тех карточек — модель
                         кончается там же, где «Общая информация», а подпись лимита начинается
                         там же, где «Параметры». Доли, а не пиксели: на узком окне страница
                         сжимается, и подобранные числа разъехались бы с карточками. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Convert_ProgrammerModelLabel}" Style="{StaticResource RowLabel}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                                      DisplayMemberPath="Name" HorizontalAlignment="Stretch"/>
                        </Grid>

                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <!-- Пустая колонка под кнопку «Обзор» соседних строк: поле
                                     байтов должно кончаться там же, где поля путей, иначе
                                     оно одно выпирает вправо. Ширину берёт у самой кнопки
                                     через SharedSizeGroup — своим числом её не повторить,
                                     кнопка шире или уже в зависимости от языка. -->
                                <ColumnDefinition Width="Auto" SharedSizeGroup="BrowseButton"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Convert_LimitLabel}" Style="{StaticResource RowLabel}"/>
                            <!-- ui:TextBox, а не обычный: подсказка внутри поля есть только у него.
                                 Обработчики принимают его как TextBox — Wpf.Ui.Controls.TextBox
                                 от него и наследуется. Отступ справа тот же 8, что у полей путей:
                                 без него правый край поля не совпал бы с ними на эти 8 пикселей. -->
                            <ui:TextBox x:Name="LimitTextBox" Grid.Column="1" ClearButtonEnabled="False" Margin="0,0,8,0"
                                        Text="{Binding CustomLimitBytesText, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding IsCustomPreset}"
                                        PlaceholderText="{loc:Loc Convert_LimitPlaceholder}"
                                        PreviewTextInput="LimitTextBox_PreviewTextInput"
                                        DataObject.Pasting="LimitTextBox_Pasting"
                                        TextChanged="LimitTextBox_TextChanged"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Общая информация и Параметры — рядом, а не друг под другом: так страница
                 не растёт вниз и на небольших мониторах её меньше приходится листать. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Common_GeneralInfoTitle}" Style="{StaticResource CardTitle}"/>

                        <!-- Пока файла нет, считать нечего, и вместо строк стоит подсказка. -->
                        <c:HintBanner Text="{loc:Loc Common_SelectFileHint}"
                                      Visibility="{Binding ShowInfoHint, Converter={StaticResource BoolToVis}}"/>

                        <StackPanel Visibility="{Binding HasInfo, Converter={StaticResource BoolToVis}}">
                            <!-- Строки разведены межстрочным интервалом, а не отступами блоков:
                                 содержимое обоих собирается кодом и число строк заранее неизвестно,
                                 а так расстояние одинаковое между всеми — и внутри блока, и на стыке.
                                 BlockLineHeight нужен, чтобы LineHeight соблюдался точно, а не
                                 только увеличивал строку при необходимости. -->
                            <TextBlock Text="{Binding GeneralInfoText}" TextWrapping="Wrap" FontSize="13"
                                       LineHeight="24" LineStackingStrategy="BlockLineHeight"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <!-- Список размеров есть не всегда (слишком много файлов, неверный
                                 лимит), а пустой TextBlock всё равно занимал бы высоту строки. -->
                            <TextBlock Text="{Binding DisplayedFilesText}" TextWrapping="Wrap" FontSize="13"
                                       LineHeight="24" LineStackingStrategy="BlockLineHeight"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DisplayedFilesText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Content="{Binding ExpandButtonText}" Command="{Binding ToggleExpandCommand}"
                                    HorizontalAlignment="Left" FontSize="11" Padding="10,4"
                                    Visibility="{Binding ShowExpandButton, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" IsEnabled="{Binding IsNotBusy}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Common_ParametersTitle}" Style="{StaticResource CardTitle}"/>
                        <CheckBox Style="{StaticResource CardCheckBox}" Content="{loc:Loc Convert_VerifyHashCheckbox}" IsChecked="{Binding VerifyHashAfter}" Margin="0,0,0,10"/>
                        <CheckBox Style="{StaticResource CardCheckBox}" Content="{loc:Loc Common_CheckDiskSpaceCheckbox}" IsChecked="{Binding CheckDiskSpace}" Margin="0,0,0,10"/>
                        <CheckBox Style="{StaticResource CardCheckBox}" Content="{loc:Loc Common_OpenFolderCheckbox}" IsChecked="{Binding OpenFolderAfter}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- «Прогресс» и кнопки стоят рядом в тех же двух колонках, что «Общая
                 информация» и «Параметры» над ними: полосам вся ширина страницы не
                 нужна, а от карточки во всю ширину кнопки уезжали вниз, дальше от
                 полей и параметров, за которыми человек и следит перед запуском.
                 Заголовка у правой карточки нет — три кнопки в нём не нуждаются. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Common_ProgressTitle}" Style="{StaticResource CardTitle}"/>

                        <c:ProgressRow Label="{loc:Loc Convert_OverallProgressLabel}"
                                       Value="{Binding OverallProgress}" Fill="#2F6FED"/>

                        <c:ProgressRow Label="{loc:Loc Common_CurrentFileProgressLabel}"
                                       Value="{Binding CurrentFileProgress}" Fill="#16A34A"
                                       Caption="{Binding CurrentFileLabel}"/>

                        <c:ProgressRow Label="{loc:Loc Convert_HashProgressLabel}"
                                       Value="{Binding ShaProgress}" Fill="#8B5CF6"
                                       IsEnabled="{Binding VerifyHashAfter}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <c:OperationBar StartText="{loc:Loc Convert_StartButton}"
                                    StartCommand="{Binding StartCommand}"
                                    PauseCommand="{Binding TogglePauseCommand}"
                                    CancelCommand="{Binding CancelCommand}"/>
                </Border>
            </Grid>

            <c:LogCard/>

        </StackPanel>
    </ScrollViewer>
</Page>
