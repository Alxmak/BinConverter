<Page x:Class="TweakFirmware.Views.ConvertPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:TweakFirmware.Services"
      xmlns:c="clr-namespace:TweakFirmware.Controls"
      Title="{loc:Loc Convert_Title}"
      ScrollViewer.CanContentScroll="False">

    <ScrollViewer x:Name="RootScroll" Padding="24,16" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="960" HorizontalAlignment="Stretch">

            <!-- Пока идёт конвертирование, поля ввода недоступны: менять исходник, папку
                 назначения или пресет на ходу нельзя — параметры разойдутся с уже
                 запущенным процессом. IsEnabled наследуется вглубь, поэтому достаточно
                 поставить его на карточку целиком. -->
            <Border Style="{StaticResource CardStyle}" IsEnabled="{Binding IsNotBusy}">
                <StackPanel>

                    <Grid Style="{StaticResource RowGrid}" AllowDrop="True" Drop="SourceRow_Drop" DragOver="SourceRow_DragOver">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc Convert_SourceFileLabel}" Style="{StaticResource RowLabel}"/>
                        <ui:TextBox ClearButtonEnabled="False" Grid.Column="1" Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                    PlaceholderText="{loc:Loc Common_NoFileSelected}"/>
                        <Button Grid.Column="2" Content="{loc:Loc Common_BrowseButton}" Command="{Binding BrowseSourceCommand}"/>
                    </Grid>

                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc Common_DestinationFolderLabel}" Style="{StaticResource RowLabel}"/>
                        <ui:TextBox ClearButtonEnabled="False" Grid.Column="1" Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                    PlaceholderText="{loc:Loc Common_NoFolderSelected}"/>
                        <Button Grid.Column="2" Content="{loc:Loc Common_BrowseButton}" Command="{Binding BrowseOutputCommand}"/>
                    </Grid>

                    <!-- Модель и лимит — в одной строке: лимит виден всегда, но правится
                         только на пользовательском пресете. У готовых моделей он фиксирован,
                         поэтому поле недоступно и просто показывает заданный лимит в байтах
                         (значение подставляет OnSelectedPresetChanged во ViewModel). -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc Convert_ProgrammerModelLabel}" Style="{StaticResource RowLabel}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                                  DisplayMemberPath="Name" HorizontalAlignment="Stretch"/>
                        <TextBlock Grid.Column="3" Text="{loc:Loc Convert_LimitLabel}" Style="{StaticResource RowLabel}"/>
                        <TextBox x:Name="LimitTextBox" Grid.Column="4"
                                 Text="{Binding CustomLimitBytesText, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsCustomPreset}"
                                 PreviewTextInput="LimitTextBox_PreviewTextInput"
                                 DataObject.Pasting="LimitTextBox_Pasting"
                                 TextChanged="LimitTextBox_TextChanged"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Общая информация и Параметры — рядом, а не друг под другом: так страница
                 не растёт вниз и на небольших мониторах её меньше приходится листать. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Convert_GeneralInfoTitle}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding GeneralInfoText}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding DisplayedFilesText}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8"/>
                        <Button Content="{Binding ExpandButtonText}" Command="{Binding ToggleExpandCommand}"
                                HorizontalAlignment="Left" FontSize="11" Padding="10,4"
                                Visibility="{Binding ShowExpandButton, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" IsEnabled="{Binding IsNotBusy}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Convert_ParametersTitle}" Style="{StaticResource CardTitle}"/>
                        <CheckBox Style="{StaticResource CardCheckBox}" Content="{loc:Loc Convert_VerifyHashCheckbox}" IsChecked="{Binding VerifyHashAfter}" Margin="0,0,0,10"/>
                        <CheckBox Style="{StaticResource CardCheckBox}" Content="{loc:Loc Convert_CheckDiskSpaceCheckbox}" IsChecked="{Binding CheckDiskSpace}" Margin="0,0,0,10"/>
                        <CheckBox Style="{StaticResource CardCheckBox}" Content="{loc:Loc Common_OpenFolderCheckbox}" IsChecked="{Binding OpenFolderAfter}" Margin="0,0,0,10"/>
                        <CheckBox Style="{StaticResource CardCheckBox}" Content="{loc:Loc Convert_DeleteSourceCheckbox}" IsChecked="{Binding DeleteSourceAfter}"/>

                        <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="10"
                                Background="#1AE5484D" BorderBrush="#E5484D" BorderThickness="1"
                                Visibility="{Binding DeleteSourceAfter, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:Loc Convert_DeleteWarning}"
                                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Common_ProgressTitle}" Style="{StaticResource CardTitle}"/>

                    <c:ProgressRow Label="{loc:Loc Convert_OverallProgressLabel}"
                                   Value="{Binding OverallProgress}" Fill="#2F6FED"/>

                    <c:ProgressRow Label="{loc:Loc Convert_CurrentFileProgressLabel}"
                                   Value="{Binding CurrentFileProgress}" Fill="#16A34A"
                                   Caption="{Binding CurrentFileLabel}"/>

                    <c:ProgressRow Label="{loc:Loc Convert_HashProgressLabel}"
                                   Value="{Binding ShaProgress}" Fill="#8B5CF6"
                                   IsEnabled="{Binding VerifyHashAfter}"/>

                    <!-- Кнопки слева, статус прижат к правому краю той же строки. -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Command="{Binding StartCommand}" Style="{StaticResource SolidButtonStyle}"
                                    Background="#2F6FED" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Play24" FontSize="14" Margin="0,0,7,0"/>
                                    <TextBlock Text="{loc:Loc Convert_StartButton}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding TogglePauseCommand}" Style="{StaticResource PauseButtonStyle}"
                                    IsEnabled="{Binding CanPause}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Pause24" FontSize="14" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding PauseButtonText}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}"
                                    Style="{StaticResource SolidButtonStyle}" Background="#E5484D">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Margin="0,0,7,0"/>
                                    <TextBlock Text="{loc:Loc Common_CancelButton}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Журнал: общий для всех разделов, с открыть/сохранить/очистить (пункты 4,5) -->
            <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="18,16,18,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc Common_LogTitle}" Style="{StaticResource CardTitle}" Margin="0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{loc:Loc Common_LogOpenButton}" Command="{Binding OpenLogCommand}" FontSize="11" Padding="8,4" Margin="0,0,6,0"/>
                            <Button Content="{loc:Loc Common_LogSaveButton}" Command="{Binding SaveLogCommand}" FontSize="11" Padding="8,4" Margin="0,0,6,0"/>
                            <Button Content="{loc:Loc Common_LogClearButton}" Command="{Binding ClearLogCommand}" FontSize="11" Padding="8,4"/>
                        </StackPanel>
                    </Grid>
                    <!-- У ListBoxItem в WPF-UI Padding="12", а заголовок карточки стоит на 18 —
                         из-за этих 6px строки журнала выпирали левее заголовка. Добираем
                         разницу отступом самого списка, чтобы текст встал на те же 18px,
                         что и содержимое всех остальных карточек. -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding LogLines}" Height="113" BorderThickness="0"
                             Margin="6,0,6,0"
                             FontFamily="Cascadia Code, Consolas" FontSize="11" Background="Transparent"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
