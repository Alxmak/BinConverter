<Page x:Class="TweakFirmware.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:TweakFirmware.Services"
      xmlns:c="clr-namespace:TweakFirmware.Controls"
      Title="{loc:Loc Settings_Title}"
      ScrollViewer.CanContentScroll="False">

    <ScrollViewer x:Name="RootScroll" Padding="24,16" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="960" HorizontalAlignment="Stretch">

            <!-- Настройки собраны группами: подпись, под ней одна карточка, внутри неё
                 строки через волосяную черту. Раньше каждая настройка была отдельной
                 карточкой, и страница читалась плоским списком из шести равнозначных
                 плиток — по нему не видно, что тема и язык об одном, а три папки
                 об одном и том же для разных разделов.

                 Подписи групп — те же прописные, что у групп в меню слева: страница
                 и меню видны одновременно, и разнобой в них заметен сразу. -->

            <TextBlock Text="{loc:Loc Settings_AppearanceGroup}" Style="{StaticResource GroupCaption}"/>
            <Border Style="{StaticResource GroupCardStyle}">
                <StackPanel>
                    <c:SettingsRow Symbol="PaintBrush24" Accent="#6366F1" Title="{loc:Loc Settings_ThemeTitle}">
                        <c:SettingsRow.Action>
                            <Border Style="{StaticResource SegmentedTrack}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{loc:Loc Settings_ThemeLight}" Command="{Binding SetThemeCommand}" CommandParameter="Light" Margin="0,0,2,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SegmentedButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentTheme}" Value="Light">
                                                        <Setter Property="Background" Value="{DynamicResource ControlSolidFillColorDefaultBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{loc:Loc Settings_ThemeDark}" Command="{Binding SetThemeCommand}" CommandParameter="Dark" Margin="0,0,2,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SegmentedButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentTheme}" Value="Dark">
                                                        <Setter Property="Background" Value="{DynamicResource ControlSolidFillColorDefaultBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{loc:Loc Settings_ThemeSystem}" Command="{Binding SetThemeCommand}" CommandParameter="System">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SegmentedButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentTheme}" Value="System">
                                                        <Setter Property="Background" Value="{DynamicResource ControlSolidFillColorDefaultBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </c:SettingsRow.Action>
                    </c:SettingsRow>

                    <Border Style="{StaticResource RowDivider}"/>

                    <c:SettingsRow Symbol="LocalLanguage24" Accent="#0D9488" Title="{loc:Loc Settings_LanguageTitle}">
                        <c:SettingsRow.Action>
                            <Border Style="{StaticResource SegmentedTrack}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{loc:Loc Settings_LanguageRu}" Command="{Binding SetLanguageCommand}" CommandParameter="ru" Margin="0,0,2,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SegmentedButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedLanguage}" Value="ru">
                                                        <Setter Property="Background" Value="{DynamicResource ControlSolidFillColorDefaultBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{loc:Loc Settings_LanguageEn}" Command="{Binding SetLanguageCommand}" CommandParameter="en">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SegmentedButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedLanguage}" Value="en">
                                                        <Setter Property="Background" Value="{DynamicResource ControlSolidFillColorDefaultBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </c:SettingsRow.Action>
                    </c:SettingsRow>
                </StackPanel>
            </Border>

            <!-- Папки: подписи «Папка назначения» у строки нет — строка уже названа
                 по своей папке, а слева на её месте стоит галочка, она и работает
                 подписью. Ширина колонки галочки «по тексту», а не общая
                 LabelColumnWidth: та держалась ради совпадения с полями на рабочих
                 вкладках, но здесь строка сдвинута под название и с ними всё равно
                 не на одной линии.

                 Значок у всех трёх один: это одна и та же настройка, только для разных
                 разделов, и разные картинки заставляли бы искать между ними разницу,
                 которой нет. Цвет при этом у каждой свой — иначе столбец из трёх
                 одинаковых плиток выглядит недоделанным. -->
            <TextBlock Text="{loc:Loc Settings_FoldersGroup}" Style="{StaticResource GroupCaption}"/>
            <Border Style="{StaticResource GroupCardStyle}">
                <StackPanel>
                    <c:SettingsRow Symbol="FolderArrowRight24" Accent="#2F6FED" Title="{loc:Loc Settings_ConvertFolderTitle}">
                        <c:SettingsRow.Extra>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Style="{StaticResource CardCheckBox}" VerticalAlignment="Center"
                                          Content="{loc:Loc Settings_UseDefaultPathCheckbox}" IsChecked="{Binding UseDefaultConvertPath}"/>
                                <ui:TextBox ClearButtonEnabled="False" Grid.Column="1" Text="{Binding ConvertFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                            PlaceholderText="{loc:Loc Common_NoFolderSelected}"
                                            IsEnabled="{Binding CanEditConvertPath}"
                                            AllowDrop="True" PreviewDragOver="ConvertFolderBox_DragOver" PreviewDrop="ConvertFolderBox_Drop"/>
                                <Button Grid.Column="2" Content="{loc:Loc Common_BrowseButton}" Command="{Binding BrowseConvertFolderCommand}"
                                        IsEnabled="{Binding CanEditConvertPath}"/>
                            </Grid>
                        </c:SettingsRow.Extra>
                    </c:SettingsRow>

                    <Border Style="{StaticResource RowDivider}"/>

                    <c:SettingsRow Symbol="FolderArrowRight24" Accent="#16A34A" Title="{loc:Loc Settings_MergeFolderTitle}">
                        <c:SettingsRow.Extra>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Style="{StaticResource CardCheckBox}" VerticalAlignment="Center"
                                          Content="{loc:Loc Settings_UseDefaultPathCheckbox}" IsChecked="{Binding UseDefaultMergePath}"/>
                                <ui:TextBox ClearButtonEnabled="False" Grid.Column="1" Text="{Binding MergeFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                            PlaceholderText="{loc:Loc Common_NoFolderSelected}"
                                            IsEnabled="{Binding CanEditMergePath}"
                                            AllowDrop="True" PreviewDragOver="MergeFolderBox_DragOver" PreviewDrop="MergeFolderBox_Drop"/>
                                <Button Grid.Column="2" Content="{loc:Loc Common_BrowseButton}" Command="{Binding BrowseMergeFolderCommand}"
                                        IsEnabled="{Binding CanEditMergePath}"/>
                            </Grid>
                        </c:SettingsRow.Extra>
                    </c:SettingsRow>

                    <Border Style="{StaticResource RowDivider}"/>

                    <c:SettingsRow Symbol="FolderArrowRight24" Accent="#D97706" Title="{loc:Loc Settings_ExtractFolderTitle}">
                        <c:SettingsRow.Extra>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Style="{StaticResource CardCheckBox}" VerticalAlignment="Center"
                                          Content="{loc:Loc Settings_UseDefaultPathCheckbox}" IsChecked="{Binding UseDefaultExtractPath}"/>
                                <ui:TextBox ClearButtonEnabled="False" Grid.Column="1" Text="{Binding ExtractFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                            PlaceholderText="{loc:Loc Common_NoFolderSelected}"
                                            IsEnabled="{Binding CanEditExtractPath}"
                                            AllowDrop="True" PreviewDragOver="ExtractFolderBox_DragOver" PreviewDrop="ExtractFolderBox_Drop"/>
                                <Button Grid.Column="2" Content="{loc:Loc Common_BrowseButton}" Command="{Binding BrowseExtractFolderCommand}"
                                        IsEnabled="{Binding CanEditExtractPath}"/>
                            </Grid>
                        </c:SettingsRow.Extra>
                    </c:SettingsRow>
                </StackPanel>
            </Border>

            <TextBlock Text="{loc:Loc Settings_MaintenanceGroup}" Style="{StaticResource GroupCaption}"/>
            <Border Style="{StaticResource GroupCardStyle}" Margin="0,0,0,20">
                <c:SettingsRow Symbol="DocumentBulletList24" Accent="#64748B"
                               Title="{loc:Loc Settings_ClearLogTitle}"
                               Description="{loc:Loc Settings_ClearLogDescription}">
                    <c:SettingsRow.Action>
                        <!-- Кнопка стоит на такой же дорожке, как варианты «Внешнего вида»,
                             и той же плашкой внутри. Без дорожки одна плашка на белой
                             карточке читалась обычной кнопкой с рамкой: форму этим
                             элементам задаёт как раз серая подложка вокруг.

                             Высоту не задаём: она набирается так же, как у вариантов
                             в дорожке, — иначе строка журнала оказалась бы выше соседних. -->
                        <Border Style="{StaticResource SegmentedTrack}">
                            <Button Content="{loc:Loc Settings_ClearLogButton}" Command="{Binding ClearLogCommand}"
                                    Style="{StaticResource PillButton}"/>
                        </Border>
                    </c:SettingsRow.Action>
                </c:SettingsRow>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
