<Page x:Class="TweakFirmware.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:TweakFirmware.Services"
      Title="{loc:Loc Settings_Title}"
      ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <!-- Пункт 11: голубая рамка вокруг выбранного варианта -->
        <Style x:Key="OptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="RootScroll" Padding="24,20" VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Stretch">

            <ui:CardControl Margin="0,0,0,12">
                <ui:CardControl.Header>
                    <TextBlock Text="{loc:Loc Settings_ThemeTitle}" FontWeight="Medium"/>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{loc:Loc Settings_ThemeLight}" Command="{Binding SetThemeCommand}" CommandParameter="Light">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OptionButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTheme}" Value="Light">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{loc:Loc Settings_ThemeDark}" Command="{Binding SetThemeCommand}" CommandParameter="Dark">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OptionButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTheme}" Value="Dark">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{loc:Loc Settings_ThemeSystem}" Command="{Binding SetThemeCommand}" CommandParameter="System">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OptionButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTheme}" Value="System">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,12">
                <ui:CardControl.Header>
                    <TextBlock Text="{loc:Loc Settings_LanguageTitle}" FontWeight="Medium"/>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{loc:Loc Settings_LanguageRu}" Command="{Binding SetLanguageCommand}" CommandParameter="ru">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OptionButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedLanguage}" Value="ru">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{loc:Loc Settings_LanguageEn}" Command="{Binding SetLanguageCommand}" CommandParameter="en">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OptionButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedLanguage}" Value="en">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,12">
                <StackPanel HorizontalAlignment="Stretch">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="{loc:Loc Settings_UseDefaultPathCheckbox}" IsChecked="{Binding UseDefaultConvertPath}"
                                  VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="1" Text="{loc:Loc Convert_Title}" VerticalAlignment="Center" FontSize="13"/>
                        <TextBox Grid.Column="2" Text="{Binding ConvertFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                 IsEnabled="{Binding CanEditConvertPath}"/>
                        <Button Grid.Column="3" Content="{loc:Loc Common_BrowseButton}" Command="{Binding BrowseConvertFolderCommand}"
                                IsEnabled="{Binding CanEditConvertPath}"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="{loc:Loc Settings_UseDefaultPathCheckbox}" IsChecked="{Binding UseDefaultMergePath}"
                                  VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="1" Text="{loc:Loc Merge_Title}" VerticalAlignment="Center" FontSize="13"/>
                        <TextBox Grid.Column="2" Text="{Binding MergeFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                 IsEnabled="{Binding CanEditMergePath}"/>
                        <Button Grid.Column="3" Content="{loc:Loc Common_BrowseButton}" Command="{Binding BrowseMergeFolderCommand}"
                                IsEnabled="{Binding CanEditMergePath}"/>
                    </Grid>
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Delete24"/>
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <TextBlock Text="{loc:Loc Settings_ClearCacheTitle}" FontWeight="Medium"/>
                </ui:CardControl.Header>
                <ui:Button Content="{loc:Loc Common_LogClearButton}" Command="{Binding ClearCacheCommand}"/>
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
