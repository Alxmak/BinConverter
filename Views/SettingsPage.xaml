<Page x:Class="BinConverter.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Настройки"
      PreviewMouseWheel="Page_PreviewMouseWheel">

    <Page.Resources>
        <!-- Пункт 11: голубая рамка вокруг выбранного варианта -->
        <Style x:Key="OptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="RootScroll" Padding="24,20" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="520" HorizontalAlignment="Left">

            <ui:CardControl Margin="0,0,0,12">
                <ui:CardControl.Header>
                    <TextBlock Text="Тема оформления" FontWeight="Medium"/>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Светлая" Command="{Binding SetThemeCommand}" CommandParameter="Light">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OptionButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTheme}" Value="Light">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Тёмная" Command="{Binding SetThemeCommand}" CommandParameter="Dark">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OptionButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTheme}" Value="Dark">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Как в системе" Command="{Binding SetThemeCommand}" CommandParameter="System">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OptionButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTheme}" Value="System">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,12">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Язык" FontWeight="Medium"/>
                        <TextBlock Text="Пока не влияет на интерфейс — задел на будущее" Opacity="0.6" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Русский" Command="{Binding SetLanguageCommand}" CommandParameter="ru">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OptionButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedLanguage}" Value="ru">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="English" Command="{Binding SetLanguageCommand}" CommandParameter="en">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OptionButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedLanguage}" Value="en">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Delete24"/>
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <TextBlock Text="Очистить кэш" FontWeight="Medium"/>
                </ui:CardControl.Header>
                <ui:Button Content="Очистить" Command="{Binding ClearCacheCommand}"/>
            </ui:CardControl>
            <TextBlock Text="Используйте эту функцию при нестабильности программы. Будут удалены временные файлы и журналы."
                       Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
