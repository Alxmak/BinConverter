<Page x:Class="TweakFirmware.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:TweakFirmware.Services"
      Title="{loc:Loc Settings_Title}"
      ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <!-- Пункт 11: голубая рамка вокруг выбранного варианта -->
        <Style x:Key="OptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="RootScroll" Padding="24,16" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="960" HorizontalAlignment="Stretch">

            <!-- Карточки как на рабочих вкладках: заголовок сверху, содержимое под ним.
                 Раньше здесь был CardControl из WPF-UI, но он всегда разносит заголовок
                 влево, а содержимое вправо, — из-за чего Настройки выбивались из
                 общего вида приложения. -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Settings_ThemeTitle}" Style="{StaticResource CardTitle}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{loc:Loc Settings_ThemeLight}" Command="{Binding SetThemeCommand}" CommandParameter="Light">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource OptionButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentTheme}" Value="Light">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{loc:Loc Settings_ThemeDark}" Command="{Binding SetThemeCommand}" CommandParameter="Dark">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource OptionButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentTheme}" Value="Dark">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{loc:Loc Settings_ThemeSystem}" Command="{Binding SetThemeCommand}" CommandParameter="System">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource OptionButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentTheme}" Value="System">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Settings_LanguageTitle}" Style="{StaticResource CardTitle}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{loc:Loc Settings_LanguageRu}" Command="{Binding SetLanguageCommand}" CommandParameter="ru">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource OptionButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedLanguage}" Value="ru">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{loc:Loc Settings_LanguageEn}" Command="{Binding SetLanguageCommand}" CommandParameter="en">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource OptionButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedLanguage}" Value="en">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Каждая папка — своя карточка со своим заголовком. Подписи «Папка назначения»
                 у строки нет: карточка уже названа по своей папке, а слева на её месте
                 стоит галочка — она и работает подписью строки. Колонка та же
                 (LabelColumnWidth), поэтому поле стоит там же, где на рабочих вкладках. -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Settings_ConvertFolderTitle}" Style="{StaticResource CardTitle}"/>
                    <Grid AllowDrop="True" Drop="ConvertFolderRow_Drop" DragOver="ConvertFolderRow_DragOver">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Style="{StaticResource CardCheckBox}" VerticalAlignment="Center"
                                  Content="{loc:Loc Settings_UseDefaultPathCheckbox}" IsChecked="{Binding UseDefaultConvertPath}"/>
                        <ui:TextBox ClearButtonEnabled="False" Grid.Column="1" Text="{Binding ConvertFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                    PlaceholderText="{loc:Loc Common_NoFolderSelected}"
                                    IsEnabled="{Binding CanEditConvertPath}"/>
                        <Button Grid.Column="2" Content="{loc:Loc Common_BrowseButton}" Command="{Binding BrowseConvertFolderCommand}"
                                IsEnabled="{Binding CanEditConvertPath}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Settings_MergeFolderTitle}" Style="{StaticResource CardTitle}"/>
                    <Grid AllowDrop="True" Drop="MergeFolderRow_Drop" DragOver="MergeFolderRow_DragOver">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Style="{StaticResource CardCheckBox}" VerticalAlignment="Center"
                                  Content="{loc:Loc Settings_UseDefaultPathCheckbox}" IsChecked="{Binding UseDefaultMergePath}"/>
                        <ui:TextBox ClearButtonEnabled="False" Grid.Column="1" Text="{Binding MergeFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                    PlaceholderText="{loc:Loc Common_NoFolderSelected}"
                                    IsEnabled="{Binding CanEditMergePath}"/>
                        <Button Grid.Column="2" Content="{loc:Loc Common_BrowseButton}" Command="{Binding BrowseMergeFolderCommand}"
                                IsEnabled="{Binding CanEditMergePath}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Settings_ClearLogTitle}" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="{loc:Loc Settings_ClearLogDescription}" TextWrapping="Wrap"
                               FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12"/>
                    <Button Content="{loc:Loc Settings_ClearLogButton}" Command="{Binding ClearLogCommand}"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
