<Page x:Class="TweakFirmware.Views.MergePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:TweakFirmware.Services"
      xmlns:c="clr-namespace:TweakFirmware.Controls"
      Title="{loc:Loc Merge_Title}"
      ScrollViewer.CanContentScroll="False">


    <!-- Esc отменяет идущую операцию. Enter на «Начать» намеренно не назначен: на этих
         страницах есть поля ввода, и нажатие Enter при правке пути запускало бы
         многочасовую запись на диск. -->
    <Page.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Page.InputBindings>

    <ScrollViewer x:Name="RootScroll" Padding="24,16" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="960" HorizontalAlignment="Stretch">

            <!-- Пока идёт сборка, поля ввода недоступны — см. тот же приём в Конвертировании. -->
            <Border Style="{StaticResource CardStyle}" IsEnabled="{Binding IsNotBusy}">
                <StackPanel>

                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc Merge_AnyChainPartLabel}" Style="{StaticResource RowLabel}"/>
                        <!-- Цель перетаскивания — само поле; см. пояснение в Конвертировании. -->
                        <ui:TextBox ClearButtonEnabled="False" Grid.Column="1" Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                    PlaceholderText="{loc:Loc Common_NoFileSelected}"
                                    AllowDrop="True" PreviewDragOver="SourceBox_DragOver" PreviewDrop="SourceBox_Drop"/>
                        <Button Grid.Column="2" Content="{loc:Loc Common_BrowseButton}" Command="{Binding BrowseSourceCommand}"/>
                    </Grid>

                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc Common_DestinationFolderLabel}" Style="{StaticResource RowLabel}"/>
                        <ui:TextBox ClearButtonEnabled="False" Grid.Column="1" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                    PlaceholderText="{loc:Loc Common_NoFolderSelected}"
                                    AllowDrop="True" PreviewDragOver="OutputBox_DragOver" PreviewDrop="OutputBox_Drop"/>
                        <Button Grid.Column="2" Content="{loc:Loc Common_BrowseButton}" Command="{Binding BrowseOutputCommand}"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc Merge_ExpectedHashLabel}" Style="{StaticResource RowLabel}"/>
                        <!-- Вставка — главный способ заполнить это поле, и именно при
                             вставке приезжает обрезанный или посторонний текст. -->
                        <ui:TextBox x:Name="ExpectedHashTextBox" ClearButtonEnabled="False" Grid.Column="1"
                                    Text="{Binding ExpectedHashText, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{loc:Loc Merge_ExpectedHashPlaceholder}"
                                    ToolTip="{loc:Loc Merge_ExpectedHashTooltip}"
                                    DataObject.Pasting="ExpectedHash_Pasting"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Рядом, а не друг под другом — как в Конвертировании, чтобы страница
                 не растягивалась вниз на небольших мониторах. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Common_GeneralInfoTitle}" Style="{StaticResource CardTitle}"/>
                        <!-- Тот же межстрочный интервал, что в Конвертировании. -->
                        <TextBlock Text="{Binding ResultSizeText}" TextWrapping="Wrap" FontSize="13"
                                   LineHeight="24" LineStackingStrategy="BlockLineHeight"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <!-- Сведения о цепочке появляются только после выбора файла; пустой
                             TextBlock всё равно занимал бы высоту строки, поэтому сворачиваем. -->
                        <TextBlock Text="{Binding ChainInfoText}" TextWrapping="Wrap" FontSize="13"
                                   LineHeight="24" LineStackingStrategy="BlockLineHeight"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ChainInfoText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" IsEnabled="{Binding IsNotBusy}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Common_ParametersTitle}" Style="{StaticResource CardTitle}"/>
                        <CheckBox Style="{StaticResource CardCheckBox}" Content="{loc:Loc Common_CheckDiskSpaceCheckbox}"
                                  IsChecked="{Binding CheckDiskSpace}" Margin="0,0,0,10"/>
                        <CheckBox Style="{StaticResource CardCheckBox}" Content="{loc:Loc Common_OpenFolderCheckbox}" IsChecked="{Binding OpenFolderAfter}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Common_ProgressTitle}" Style="{StaticResource CardTitle}"/>

                    <c:ProgressRow Label="{loc:Loc Merge_OverallProgressLabel}"
                                   Value="{Binding OverallProgress}" Fill="#2F6FED"/>

                    <c:ProgressRow Label="{loc:Loc Common_CurrentFileProgressLabel}"
                                   Value="{Binding CurrentFileProgress}" Fill="#16A34A"
                                   Caption="{Binding CurrentFileLabel}"/>

                    <c:OperationBar StartText="{loc:Loc Merge_StartButton}"
                                    StartCommand="{Binding StartCommand}"
                                    PauseCommand="{Binding TogglePauseCommand}"
                                    CancelCommand="{Binding CancelCommand}"/>
                </StackPanel>
            </Border>

            <c:LogCard/>

        </StackPanel>
    </ScrollViewer>
</Page>
