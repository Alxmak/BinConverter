<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TweakFirmware</AssemblyName>
    <RootNamespace>TweakFirmware</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ApplicationTitle>Tweak Firmware</ApplicationTitle>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Version>2.8.5</Version>
    <AssemblyVersion>2.8.5.0</AssemblyVersion>
    <FileVersion>2.8.5.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Папка тестового проекта лежит внутри этой же директории — явно исключаем её,
         иначе SDK-стиль проекта автоматически подхватит .cs файлы тестов и в основную
         программу тоже (а там нет ссылки на xUnit -> ошибки CS0246 про FactAttribute). -->
    <Compile Remove="TweakFirmware.Tests\**" />
    <EmbeddedResource Remove="TweakFirmware.Tests\**" />
    <None Remove="TweakFirmware.Tests\**" />
    <Page Remove="TweakFirmware.Tests\**" />

    <!-- Папка TweakFirmware.Core теперь отдельный проект — тоже исключаем из этой сборки. -->
    <Compile Remove="TweakFirmware.Core\**" />
    <EmbeddedResource Remove="TweakFirmware.Core\**" />
    <None Remove="TweakFirmware.Core\**" />
    <Page Remove="TweakFirmware.Core\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="TweakFirmware.Core\TweakFirmware.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon-256.png" />
    <Resource Include="Assets\AppIcon-64.png" />
    <Resource Include="Assets\AppIcon-32.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
