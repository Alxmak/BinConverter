<UserControl x:Class="TweakFirmware.Controls.IconTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">

    <!-- Значок в цветной плитке — общая деталь вкладок «О программе» и «Настройки».

         Вынесена отдельно, потому что величины здесь связаны между собой: размер
         плитки, скругление, кегль значка и прозрачность заливки подобраны друг под
         друга, и стоит одной плитке отличиться, как столбец карточек перестаёт
         читаться списком. Скопировать эти четыре числа во второй раз — значит
         однажды поправить их только в одном месте. -->
    <Grid Width="46" Height="46">
        <!-- Заливка плитки — тот же акцентный цвет, только приглушённый прозрачностью.
             Не отдельный светлый оттенок: он подбирается под светлую тему, а на тёмной
             такая плашка светится белым пятном. Прозрачность одинаково уместна
             в обеих темах. -->
        <Border Background="{Binding Accent, ElementName=Root}" Opacity="0.14" CornerRadius="12"/>
        <ui:SymbolIcon Symbol="{Binding Symbol, ElementName=Root}" FontSize="22"
                       Foreground="{Binding Accent, ElementName=Root}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
