<UserControl x:Class="TweakFirmware.Controls.AboutCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">

    <!-- Строка раздела «О программе»: значок в цветной плитке слева, заголовок
         с пояснением по центру и необязательное действие справа.

         Отдельным контролом, а не четырьмя одинаковыми сетками в разметке:
         карточек на вкладке четыре, и стоит одной из них разъехаться по отступам
         или размеру плитки, как весь столбец перестаёт читаться списком. -->
    <Border Style="{StaticResource CardStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Плитка со значком. Вверху, а не по центру: в карточках с кнопками
                 и ссылками содержимое высокое, и по центру значок оказывался бы
                 напротив пустого места, а не напротив заголовка. -->
            <Grid Grid.Column="0" Width="46" Height="46" Margin="0,0,16,0" VerticalAlignment="Top">
                <!-- Заливка плитки — тот же акцентный цвет, только приглушённый
                     прозрачностью. Не отдельный светлый оттенок: он подбирается под
                     светлую тему, а на тёмной такая плашка светится белым пятном.
                     Прозрачность одинаково уместна в обеих темах. -->
                <Border Background="{Binding Accent, ElementName=Root}" Opacity="0.14" CornerRadius="12"/>
                <ui:SymbolIcon Symbol="{Binding Symbol, ElementName=Root}" FontSize="22"
                               Foreground="{Binding Accent, ElementName=Root}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- Вверху, а не по центру, и по той же причине, что плитка: высоту
                 карточки задаёт самая высокая колонка (в «Обратной связи» это две
                 кнопки справа), и текст, выровненный по центру, уезжал от значка
                 к середине карточки. -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <TextBlock Text="{Binding Title, ElementName=Root}" FontSize="15" FontWeight="SemiBold"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                <!-- Пояснение необязательно: без него пустой TextBlock всё равно
                     занимал бы высоту строки и отрывал заголовок от содержимого. -->
                <TextBlock Text="{Binding Description, ElementName=Root}" FontSize="13" Margin="0,5,0,0"
                           TextWrapping="Wrap" LineHeight="19" LineStackingStrategy="BlockLineHeight"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Description, ElementName=Root}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ContentPresenter Content="{Binding Extra, ElementName=Root}"/>
            </StackPanel>

            <!-- Пустое место справа тоже занимает ширину: у карточки без действия
                 отступ 16 сдвигал бы текст, поэтому колонку целиком сворачиваем. -->
            <ContentPresenter Grid.Column="2" Content="{Binding Action, ElementName=Root}"
                              VerticalAlignment="Center" Margin="16,0,0,0">
                <ContentPresenter.Style>
                    <Style TargetType="ContentPresenter">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Action, ElementName=Root}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentPresenter.Style>
            </ContentPresenter>
        </Grid>
    </Border>
</UserControl>
