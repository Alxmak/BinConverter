<UserControl x:Class="TweakFirmware.Controls.LogCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TweakFirmware.Services">

    <!-- Журнал общий на всё приложение, поэтому и карточка одна на все разделы.
         Своего DataContext контрол не ставит — привязки берут его у страницы,
         на которой стоит контрол (LogLines и три команды журнала). -->
    <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="18,16,18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Loc Common_LogTitle}" Style="{StaticResource CardTitle}" Margin="0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{loc:Loc Common_LogOpenButton}" Command="{Binding OpenLogCommand}" FontSize="11" Padding="8,4" Margin="0,0,6,0"/>
                    <Button Content="{loc:Loc Common_LogSaveButton}" Command="{Binding SaveLogCommand}" FontSize="11" Padding="8,4" Margin="0,0,6,0"/>
                    <Button Content="{loc:Loc Common_LogClearButton}" Command="{Binding ClearLogCommand}" FontSize="11" Padding="8,4"/>
                </StackPanel>
            </Grid>
            <!-- У ListBoxItem в WPF-UI Padding="12", а заголовок карточки стоит на 18 —
                 из-за этих 6px строки журнала выпирали левее заголовка. Добираем
                 разницу отступом самого списка, чтобы текст встал на те же 18px,
                 что и содержимое всех остальных карточек. -->
            <ListBox Grid.Row="1" ItemsSource="{Binding LogLines}" Height="113" BorderThickness="0"
                     Margin="6,0,6,0"
                     FontFamily="Cascadia Code, Consolas" FontSize="11" Background="Transparent"/>
        </Grid>
    </Border>
</UserControl>
