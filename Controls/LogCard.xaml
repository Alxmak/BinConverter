<UserControl x:Class="TweakFirmware.Controls.LogCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TweakFirmware.Services">

    <UserControl.Resources>
        <!-- Своя подсветка строки вместо стандартной. У WPF-UI выделенная строка
             заливается акцентным синим на всю ширину — для журнала, который только
             читают, это слишком громко. Здесь еле заметная серая подложка: серый
             с малой прозрачностью одинаково уместен и на светлой теме, и на тёмной,
             поэтому взят цветом, а не темовой кистью.

             BasedOn обязателен: явный стиль иначе полностью заменяет неявный стиль
             библиотеки, и вместе с ним пропадёт Padding="12" — а на нём держится
             выравнивание строк журнала по заголовку карточки (6 у списка + 12 = 18). -->
        <Style x:Key="LogLine" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="4"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#14808080"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#24808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Журнал общий на всё приложение, поэтому и карточка одна на все разделы.
         Своего DataContext контрол не ставит — привязки берут его у страницы,
         на которой стоит контрол (LogLines и три команды журнала). -->
    <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="18,16,18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Loc Common_LogTitle}" Style="{StaticResource CardTitle}" Margin="0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{loc:Loc Common_LogOpenButton}" Command="{Binding OpenLogCommand}" FontSize="11" Padding="8,4" Margin="0,0,6,0"/>
                    <Button Content="{loc:Loc Common_LogSaveButton}" Command="{Binding SaveLogCommand}" FontSize="11" Padding="8,4" Margin="0,0,6,0"/>
                    <Button Content="{loc:Loc Common_LogClearButton}" Command="{Binding ClearLogCommand}" FontSize="11" Padding="8,4"/>
                </StackPanel>
            </Grid>
            <!-- У ListBoxItem в WPF-UI Padding="12", а заголовок карточки стоит на 18 —
                 из-за этих 6px строки журнала выпирали левее заголовка. Добираем
                 разницу отступом самого списка, чтобы текст встал на те же 18px,
                 что и содержимое всех остальных карточек. -->
            <!-- Высота списка не задаётся здесь: её ставит код по числу видимых строк
                 (пять при запуске, от одной до десяти ручкой внизу карточки). В разметке
                 стояло бы число в пикселях, а строка журнала выше или ниже в зависимости
                 от отступов ListBoxItem в теме — и «пять строк» перестало бы быть пятью. -->
            <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding LogLines}" BorderThickness="0"
                     Margin="6,0,6,0" ItemContainerStyle="{StaticResource LogLine}"
                     FontFamily="Cascadia Code, Consolas" FontSize="11" Background="Transparent"
                     SelectionMode="Extended" KeyDown="LogList_KeyDown"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <!-- Строки переносятся, а не обрезаются: в журнал попадают полные пути
                     и хэши, и раньше их конец было просто не увидеть. -->
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <!-- Выделение строки теперь не просто подсветка: её можно скопировать —
                     из журнала часто нужен хэш или путь. -->
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{loc:Loc Common_LogCopyButton}" Click="CopySelected_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <!-- Ручка высоты журнала: посередине под списком, как у окон с изменяемым
                 размером. Thumb, а не кнопка: он сам захватывает мышь от нажатия до
                 отпускания и присылает смещение, тогда как кнопке пришлось бы вручную
                 ловить MouseDown/Move/Up и не потерять захват при уходе курсора
                 за пределы карточки. -->
            <Thumb x:Name="ResizeGrip" Grid.Row="2" Cursor="SizeNS"
                   HorizontalAlignment="Center" Margin="0,2,0,6"
                   ToolTip="{loc:Loc Common_LogResizeTooltip}"
                   DragStarted="ResizeGrip_DragStarted" DragDelta="ResizeGrip_DragDelta"
                   DragCompleted="ResizeGrip_DragCompleted">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <!-- Прозрачная подложка вокруг полоски: в саму полоску высотой
                             4px попасть мышью трудно, а цель для нажатия должна быть
                             заметно больше того, что нарисовано. -->
                        <Border Background="Transparent" Padding="16,7">
                            <!-- Серый с прозрачностью, а не кисть темы: одинаково
                                 читается и на светлой карточке, и на тёмной. -->
                            <Border x:Name="Bar" Width="36" Height="4" CornerRadius="2"
                                    Background="#59808080" SnapsToDevicePixels="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="#99808080"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="#99808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</UserControl>
