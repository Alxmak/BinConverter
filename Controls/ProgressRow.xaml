<UserControl x:Class="TweakFirmware.Controls.ProgressRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!-- Одна строка прогресса: подпись слева, "пилюля" по центру, проценты справа
         и необязательная строка-уточнение под баром (имя текущего файла и т.п.). -->
    <StackPanel Margin="0,0,0,16">
        <StackPanel.Style>
            <Style TargetType="StackPanel">
                <Style.Triggers>
                    <!-- Ненужную сейчас строку выключают через IsEnabled на самом
                         контроле — так в «Конвертировании» гаснет SHA-256, пока сверка
                         хэша не отмечена. Одного IsEnabled для этого не хватало: у
                         TextBlock нет вида «выключен», а заливка полосы при нуле
                         процентов не видна, и выключенная строка выглядела точно
                         так же, как рабочая. Поэтому гасим строку целиком — подпись,
                         полосу и проценты, — той же прозрачностью 0.45, что и у
                         остальных выключенных частей интерфейса в AppStyles. -->
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </StackPanel.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding Label, ElementName=Root}"
                       Style="{StaticResource RowLabel}"/>

            <ProgressBar Grid.Column="1" Style="{StaticResource ProgressBarPill}"
                         Value="{Binding Value, ElementName=Root, Mode=OneWay}"
                         Foreground="{Binding Fill, ElementName=Root}"/>

            <TextBlock Grid.Column="2" Width="40" Margin="10,0,0,0" TextAlignment="Right"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       FontFamily="Cascadia Code, Consolas" FontSize="10"
                       Text="{Binding Value, ElementName=Root, StringFormat={}{0:F0}%}"/>
        </Grid>

        <TextBlock Margin="200,3,0,0" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="{Binding Caption, ElementName=Root}"
                   TextTrimming="CharacterEllipsis">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Caption, ElementName=Root}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Caption, ElementName=Root}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
