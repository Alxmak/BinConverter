<UserControl x:Class="TweakFirmware.Controls.ProgressRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!-- Одна строка прогресса: подпись слева, "пилюля" по центру, проценты справа
         и необязательная строка-уточнение под баром (имя текущего файла и т.п.). -->
    <StackPanel Margin="0,0,0,16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding Label, ElementName=Root}"
                       Style="{StaticResource RowLabel}"/>

            <ProgressBar Grid.Column="1" Style="{StaticResource ProgressBarPill}"
                         Value="{Binding Value, ElementName=Root, Mode=OneWay}"
                         Foreground="{Binding Fill, ElementName=Root}"/>

            <TextBlock Grid.Column="2" Width="40" Margin="10,0,0,0" TextAlignment="Right"
                       VerticalAlignment="Center" Opacity="0.55"
                       FontFamily="Cascadia Code, Consolas" FontSize="10"
                       Text="{Binding Value, ElementName=Root, StringFormat={}{0:F0}%}"/>
        </Grid>

        <TextBlock Margin="200,3,0,0" FontSize="10" Opacity="0.55"
                   Text="{Binding Caption, ElementName=Root}"
                   TextTrimming="CharacterEllipsis">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Caption, ElementName=Root}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Caption, ElementName=Root}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
