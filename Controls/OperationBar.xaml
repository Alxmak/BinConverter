<UserControl x:Class="TweakFirmware.Controls.OperationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:TweakFirmware.Services"
             x:Name="Root">

    <!-- Только кнопки. Статусной строки справа больше нет: она повторяла то, что уже
         видно рядом — проценты у каждого бара, состояние паузы на самой кнопке,
         итог в диалоге и в журнале.

         Доступность кнопок никак не задаётся здесь: её решает CanExecute самих команд
         во ViewModel.

         Кнопки идут сверху вниз и растянуты по ширине: строка кнопок стоит в своей
         узкой карточке справа от «Прогресса», а в ряд три подписи («Начать»,
         «Приостановить», «Отмена») в половину ширины страницы не помещаются.
         Растянуты, а не по своей ширине, потому что подписи разной длины и
         прижатые влево кнопки выглядели бы лесенкой. -->
    <StackPanel>
        <Button Command="{Binding StartCommand, ElementName=Root}" Style="{StaticResource SolidButtonStyle}"
                Background="#2F6FED" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Play24" FontSize="14" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding StartText, ElementName=Root}"/>
            </StackPanel>
        </Button>

        <!-- Кнопки паузы нет там, где паузы нет: в «Проверке SHA-256» страница просто
             не передаёт PauseCommand, и кнопка не показывается. Подпись берётся у
             ViewModel страницы — она же меняет её на «Возобновить». -->
        <Button x:Name="PauseButton" Command="{Binding PauseCommand, ElementName=Root}"
                Style="{StaticResource PauseButtonStyle}" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Pause24" FontSize="14" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding PauseButtonText}"/>
            </StackPanel>
        </Button>

        <Button Command="{Binding CancelCommand, ElementName=Root}"
                Style="{StaticResource SolidButtonStyle}" Background="#E5484D">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Margin="0,0,7,0"/>
                <TextBlock Text="{loc:Loc Common_CancelButton}"/>
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
